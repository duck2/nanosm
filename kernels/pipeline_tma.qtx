; Double-buffered vector add with a TMA producer and a SIMT consumer.
; Two descriptor arguments (A, B: dense one-dimensional tensors, a
; 16-element tile); each stage's buffer and full barrier are tma.load.1d
; operands (src/tma.hpp). The coordinate advances by one tile. Barriers,
; parities, buffers and the coordinate are uniform registers, and so is each
; role's loop counter (%left, tested with usetp).

.warps  2
.param  desc ADESC      ; A and B: dense one-dimensional tensors, one tile per load
.param  desc BDESC
.param  ptr  C          ; the output's global address
.shmem A_TILE[2], bytes=64    ; the two stages' buffers; qtxc places them
.shmem B_TILE[2], bytes=64
.mbar FULL[2],  expect 1    ; a pair is an array: FULL[1] is 8 bytes after FULL[0]
.mbar EMPTY[2], expect 1

        usread %warp, WARP_ID
        usetp.eq.u32 p0, %warp, 0
@p0     bra.uni PRODUCER

; ---- consumer: warp 1 ----
        sread %lane, LANE_ID
        shli  %lane, %lane, 2
        ld.param.u32 %c_base, [C]  ; C's low word (an stg address is one 32-bit register)
        add   %c_ptr, %lane, %c_base
        umov  %full0, FULL[0]
        umov  %full1, FULL[1]
        umov  %empty0, EMPTY[0]
        umov  %empty1, EMPTY[1]
        umov  %parity0, 0
        umov  %parity1, 0
        umov  %left, 4
CLOOP:  usetp.le.s32 p1, %left, 0
@p1     bra.uni CDONE
CF0:    mbar.try_wait p3, [%full0], %parity0
@!p3    bra.uni CF0
        uxori %parity0, %parity0, 1
        lds   %x, [%lane + A_TILE[0]]
        lds   %y, [%lane + B_TILE[0]]
        fadd  %x, %x, %y
        mbar.arrive [%empty0]
        stg   [%c_ptr], %x
        addi  %c_ptr, %c_ptr, 64
CF1:    mbar.try_wait p3, [%full1], %parity1
@!p3    bra.uni CF1
        uxori %parity1, %parity1, 1
        lds   %x, [%lane + A_TILE[1]]
        lds   %y, [%lane + B_TILE[1]]
        fadd  %x, %x, %y
        mbar.arrive [%empty1]
        stg   [%c_ptr], %x
        addi  %c_ptr, %c_ptr, 64
        uaddi %left, %left, -1
        bra.uni CLOOP
CDONE:  halt

; ---- producer: warp 0 ----
PRODUCER:
        umov  %full0, FULL[0]
        umov  %full1, FULL[1]
        umov  %empty0, EMPTY[0]
        umov  %empty1, EMPTY[1]
        umov  %parity0, 0
        umov  %parity1, 0
; The stage buffers (%buf_a0 .. %buf_b1) and the tile's coordinate (%tile, c0 in
; elements) are uniform registers beside the barriers; the coordinate moves
; on by one 16-element tile after each stage's pair of loads.
        umov  %buf_a0, A_TILE[0]
        umov  %buf_b0, B_TILE[0]
        umov  %buf_a1, A_TILE[1]
        umov  %buf_b1, B_TILE[1]
        umov  %tile, 0

        mbar.arrive.expect_tx [%full0], 128
        tma.load.1d [%buf_a0], [ADESC, %tile], [%full0]
        tma.load.1d [%buf_b0], [BDESC, %tile], [%full0]
        uaddi %tile, %tile, 16
        mbar.arrive.expect_tx [%full1], 128
        tma.load.1d [%buf_a1], [ADESC, %tile], [%full1]
        tma.load.1d [%buf_b1], [BDESC, %tile], [%full1]
        uaddi %tile, %tile, 16

        umov  %left, 6
PLOOP:  usetp.le.s32 p1, %left, 0
@p1     bra.uni PDONE
PE0:    mbar.try_wait p3, [%empty0], %parity0
@!p3    bra.uni PE0
        uxori %parity0, %parity0, 1
        mbar.arrive.expect_tx [%full0], 128
        tma.load.1d [%buf_a0], [ADESC, %tile], [%full0]
        tma.load.1d [%buf_b0], [BDESC, %tile], [%full0]
        uaddi %tile, %tile, 16
        uaddi %left, %left, -1
        usetp.le.s32 p1, %left, 0
@p1     bra.uni PDONE
PE1:    mbar.try_wait p3, [%empty1], %parity1
@!p3    bra.uni PE1
        uxori %parity1, %parity1, 1
        mbar.arrive.expect_tx [%full1], 128
        tma.load.1d [%buf_a1], [ADESC, %tile], [%full1]
        tma.load.1d [%buf_b1], [BDESC, %tile], [%full1]
        uaddi %tile, %tile, 16
        uaddi %left, %left, -1
        bra.uni PLOOP
PDONE:  halt
