; Double-buffered vector add with a TMA producer and a SIMT consumer.
; Two launch-authored descriptors (A, B: dense one-dimensional tensors, a
; 16-element tile); each stage's buffer and full barrier are tma.load.1d
; operands (src/tma.hpp). The coordinate advances by one tile. Barriers,
; parities, buffers and the coordinate are uniform registers (ur1..ur11), and
; so is each role's loop counter (ur12, tested with usetp).

.equ C,      8192
.equ SA0,    0
.equ SB0,    64
.equ SA1,    128
.equ SB1,    192
.equ FULL0,  1024
.equ FULL1,  1032
.equ EMPTY0, 1040
.equ EMPTY1, 1048
.equ ADESC,  1152
.equ BDESC,  1216

        usread ur0, WARP_ID
        usetp.eq p0, ur0, 0
@p0     bra.uni PRODUCER

; ---- consumer: warp 1 ----
        sread r0, LANE_ID
        shli  r0, r0, 2
        addi  r10, r0, SA0
        addi  r11, r0, SB0
        addi  r12, r0, SA1
        addi  r13, r0, SB1
        addi  r1, r0, C
        umov  ur1, FULL0
        umov  ur2, FULL1
        umov  ur3, EMPTY0
        umov  ur4, EMPTY1
        umov  ur5, 0
        umov  ur6, 0
        umov  ur12, 4
CLOOP:  usetp.le p1, ur12, 0
@p1     bra.uni CDONE
CF0:    mbar.try_wait p3, [ur1], ur5
@!p3    bra.uni CF0
        uxori ur5, ur5, 1
        lds   r8, [r10]
        lds   r9, [r11]
        fadd  r8, r8, r9
        mbar.arrive [ur3]
        stg   [r1], r8
        addi  r1, r1, 64
CF1:    mbar.try_wait p3, [ur2], ur6
@!p3    bra.uni CF1
        uxori ur6, ur6, 1
        lds   r8, [r12]
        lds   r9, [r13]
        fadd  r8, r8, r9
        mbar.arrive [ur4]
        stg   [r1], r8
        addi  r1, r1, 64
        uaddi ur12, ur12, -1
        bra.uni CLOOP
CDONE:  halt

; ---- producer: warp 0 ----
PRODUCER:
        umov  ur1, FULL0
        umov  ur2, FULL1
        umov  ur3, EMPTY0
        umov  ur4, EMPTY1
        umov  ur5, 0
        umov  ur6, 0
; The stage buffers (ur7..ur10) and the tile's coordinate (ur11, c0 in
; elements) are uniform registers beside the barriers; the coordinate moves
; on by one 16-element tile after each stage's pair of loads.
        umov  ur7, SA0
        umov  ur8, SB0
        umov  ur9, SA1
        umov  ur10, SB1
        umov  ur11, 0

        mbar.arrive.expect_tx [ur1], 128
        tma.load.1d [ur7], [ADESC, ur11], [ur1]
        tma.load.1d [ur8], [BDESC, ur11], [ur1]
        uaddi ur11, ur11, 16
        mbar.arrive.expect_tx [ur2], 128
        tma.load.1d [ur9], [ADESC, ur11], [ur2]
        tma.load.1d [ur10], [BDESC, ur11], [ur2]
        uaddi ur11, ur11, 16

        umov  ur12, 6
PLOOP:  usetp.le p1, ur12, 0
@p1     bra.uni PDONE
PE0:    mbar.try_wait p3, [ur3], ur5
@!p3    bra.uni PE0
        uxori ur5, ur5, 1
        mbar.arrive.expect_tx [ur1], 128
        tma.load.1d [ur7], [ADESC, ur11], [ur1]
        tma.load.1d [ur8], [BDESC, ur11], [ur1]
        uaddi ur11, ur11, 16
        uaddi ur12, ur12, -1
        usetp.le p1, ur12, 0
@p1     bra.uni PDONE
PE1:    mbar.try_wait p3, [ur4], ur6
@!p3    bra.uni PE1
        uxori ur6, ur6, 1
        mbar.arrive.expect_tx [ur2], 128
        tma.load.1d [ur9], [ADESC, ur11], [ur2]
        tma.load.1d [ur10], [BDESC, ur11], [ur2]
        uaddi ur11, ur11, 16
        uaddi ur12, ur12, -1
        bra.uni PLOOP
PDONE:  halt
