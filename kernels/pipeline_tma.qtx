; Double-buffered vector add with a TMA producer and a SIMT consumer.
; Two launch-authored descriptors (A, B); each stage's destination and
; full barrier are the tma.load address operand (src/tma.hpp). The x
; coordinate advances by one 16-element tile; no swizzle, no transpose.
; The barrier addresses and parities are uniform registers (ur1..ur6); the
; TMA operands (coordinates, address operands) stay vector registers.

.equ C,      8192
.equ SA0,    0
.equ SB0,    64
.equ SA1,    128
.equ SB1,    192
.equ FULL0,  1024
.equ FULL1,  1032
.equ EMPTY0, 1040
.equ EMPTY1, 1048
.equ ADESC,  1152
.equ BDESC,  1216

        usread ur0, WARP_ID
        ur2r  r0, ur0
        setp.eq p0, r0, 0
@p0     bra.uni PRODUCER

; ---- consumer: warp 1 ----
        sread r0, LANE_ID
        shli  r0, r0, 2
        addi  r10, r0, SA0
        addi  r11, r0, SB0
        addi  r12, r0, SA1
        addi  r13, r0, SB1
        addi  r1, r0, C
        umov  ur1, FULL0
        umov  ur2, FULL1
        umov  ur3, EMPTY0
        umov  ur4, EMPTY1
        umov  ur5, 0
        umov  ur6, 0
        mov   r3, 4
CLOOP:  setp.le p1, r3, 0
@p1     bra.uni CDONE
CF0:    mbar.try_wait p3, [ur1], ur5
@!p3    bra.uni CF0
        uxori ur5, ur5, 1
        lds   r8, [r10]
        lds   r9, [r11]
        fadd  r8, r8, r9
        mbar.arrive [ur3]
        stg   [r1], r8
        addi  r1, r1, 64
CF1:    mbar.try_wait p3, [ur2], ur6
@!p3    bra.uni CF1
        uxori ur6, ur6, 1
        lds   r8, [r12]
        lds   r9, [r13]
        fadd  r8, r8, r9
        mbar.arrive [ur4]
        stg   [r1], r8
        addi  r1, r1, 64
        addi  r3, r3, -1
        bra.uni CLOOP
CDONE:  halt

; ---- producer: warp 0 ----
PRODUCER:
        umov  ur1, FULL0
        umov  ur2, FULL1
        umov  ur3, EMPTY0
        umov  ur4, EMPTY1
        umov  ur5, 0
        umov  ur6, 0
        mov   r14, 0
        mov   r15, 0
; Address operands (src/tma.hpp): the stage / 64 in bits 31:16 (the shli by
; 10 of its 64-byte-aligned address), the full barrier / 8 in bits 15:0; in RF
; bank 1 (register mod 3 == 1) beside the coordinates r14 / r15 (banks 2 / 0).
        mov   r5, FULL0
        mov   r6, FULL1
        mov   r4, SA0
        mov   r7, SB0
        mov   r10, SA1
        mov   r13, SB1
        shri  r5, r5, 3
        shri  r6, r6, 3
        shli  r4, r4, 10
        shli  r7, r7, 10
        shli  r10, r10, 10
        shli  r13, r13, 10
        or    r4, r4, r5
        or    r7, r7, r5
        or    r10, r10, r6
        or    r13, r13, r6

        mbar.arrive.expect_tx [ur1], 128
        tma.load [ADESC], r14, r4
        tma.load [BDESC], r14, r7
        addi  r14, r14, 16
        mbar.arrive.expect_tx [ur2], 128
        tma.load [ADESC], r14, r10
        tma.load [BDESC], r14, r13
        addi  r14, r14, 16

        mov   r3, 6
PLOOP:  setp.le p1, r3, 0
@p1     bra.uni PDONE
PE0:    mbar.try_wait p3, [ur3], ur5
@!p3    bra.uni PE0
        uxori ur5, ur5, 1
        mbar.arrive.expect_tx [ur1], 128
        tma.load [ADESC], r14, r4
        tma.load [BDESC], r14, r7
        addi  r14, r14, 16
        addi  r3, r3, -1
        setp.le p1, r3, 0
@p1     bra.uni PDONE
PE1:    mbar.try_wait p3, [ur4], ur6
@!p3    bra.uni PE1
        uxori ur6, ur6, 1
        mbar.arrive.expect_tx [ur2], 128
        tma.load [ADESC], r14, r10
        tma.load [BDESC], r14, r13
        addi  r14, r14, 16
        addi  r3, r3, -1
        bra.uni PLOOP
PDONE:  halt
