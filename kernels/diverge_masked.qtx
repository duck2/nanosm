; Per-lane Collatz step counts, kernels/diverge.qtx with the odd / even step
; done by masked instructions (@p / @!p) instead of ssy / bra / sync /
; sync. Lane l of warp w reads n = IN[16 w + l] (n >= 1) and counts the steps
; n -> n / 2 (n even) or 3 n + 1 (n odd) until n is 1. Every lane of the step
; issues both arms; each arm's result is written with its predicate as the
; mask, so the odd lanes write 3 n + 1 and the even lanes n / 2, and nothing
; moves the pc. The loop still
; sheds lanes with the divergence stack, laid out as in diverge.qtx: the
; leavers fall into the sync, which switches to the stayers (back at STEP);
; when none stays it pops the ssy's entry, DONE. The stack holds at most two
; entries.
; Launch: kernels/diverge_masked.launch.py.

.param ptr IN                 ; 16 x warps inputs (u32)
.param ptr OUT                ; as many step counts

        usread ur0, WARP_ID
        ushli  ur0, ur0, 6            ; 64 bytes per warp
        ur2r   r1, ur0
        sread  r2, LANE_ID
        shli   r2, r2, 2
        add    r1, r1, r2             ; this lane's byte offset
        umov   ur1, IN
        umov   ur2, OUT
        lds.uni r8, [ur1]             ; the pointers' low words (an ldg / stg
        lds.uni r9, [ur2]             ; address is one 32-bit register)
        add    r10, r1, r8            ; this lane's input address
        add    r12, r1, r9            ; and its output address
        ldg    r3, [r10]              ; n
        mov    r5, 0                  ; steps
        ssy    DONE                   ; (every lane, DONE)
        bra    TEST                   ; a lane that starts at 1 never steps
STEP:   andi   r6, r3, 1
        setp.ne.u32 p1, r6, 0         ; n odd
        shli   r7, r3, 1              ; 2 n, every lane
        @p1 add  r3, r3, r7           ; odd: n = 3 n + 1
        @p1 addi r3, r3, 1
        @!p1 shri r3, r3, 1           ; even: n = n / 2 (p1 is the old n's)
        addi   r5, r5, 1
TEST:   setp.ne.u32 p0, r3, 1         ; lanes not yet at 1 go round again
        @p0 bra STEP                  ; (staying lanes, STEP); the leavers fall through
        sync                          ; leavers switch to the stayers; the last pops (every lane, DONE)
DONE:   stg    [r12], r5              ; every lane, once
        halt
