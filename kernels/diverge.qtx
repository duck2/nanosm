; Per-lane Collatz step counts: a loop whose trip count is each lane's own
; data (trash/divergence-2026-11-21.md). Lane l of warp w reads n = IN[16 w + l]
; (n >= 1) and counts the steps n -> n / 2 (n even) or 3 n + 1 (n odd) until
; n is 1. Each step is a per-lane if / else whose arms each end in a sync;
; the loop sheds lanes as they reach 1. Every sync pops a (mask, pc) entry
; and switches to it. The loop is laid out as in
; trash/divergence-loop-astra.py: the first pass goes to the test, and the
; lanes that leave fall into the sync, which switches to the lanes that stay
; (back at STEP); when none stays it pops the ssy's entry, DONE. So the stack
; holds at most the loop's entry and, inside a step, the step's entry and
; the even lanes': three entries.
; Launch: kernels/diverge.launch.py.

.param ptr IN                 ; 16 x warps inputs (u32)
.param ptr OUT                ; as many step counts

        usread %warp_offset, WARP_ID
        ushli  %warp_offset, %warp_offset, 6 ; 64 bytes per warp
        ur2r   %offset, %warp_offset
        sread  %lane, LANE_ID
        shli   %lane, %lane, 2
        add    %offset, %offset, %lane ; this lane's byte offset
        umov   %in_arg, IN
        umov   %out_arg, OUT
        lds.uni %in_base, [%in_arg]   ; the pointers' low words (an ldg / stg
        lds.uni %out_base, [%out_arg] ; address is one 32-bit register)
        add    %in_ptr, %offset, %in_base ; this lane's input address
        add    %out_ptr, %offset, %out_base ; and its output address
        ldg    %n, [%in_ptr]          ; n
        mov    %steps, 0              ; steps
        ssy    DONE                   ; (every lane, DONE)
        bra    TEST                   ; a lane that starts at 1 never steps
STEP:   andi   %low_bit, %n, 1
        setp.eq.u32 p1, %low_bit, 0   ; n even
        ssy    NEXT                   ; (this step's lanes, NEXT)
        @p1 bra EVEN                  ; odd lanes fall through first; (even lanes, EVEN)
        shli   %twice, %n, 1          ; odd: n = 3 n + 1
        add    %n, %n, %twice
        addi   %n, %n, 1
        sync                          ; odd lanes done: switch to the even ones
EVEN:   shri   %n, %n, 1              ; even: n = n / 2
        sync                          ; even lanes done: every lane of the step, at NEXT
NEXT:   addi   %steps, %steps, 1
TEST:   setp.ne.u32 p0, %n, 1         ; lanes not yet at 1 go round again
        @p0 bra STEP                  ; (staying lanes, STEP); the leavers fall through
        sync                          ; leavers switch to the stayers; the last pops (every lane, DONE)
DONE:   stg    [%out_ptr], %steps     ; every lane, once
        halt
