; First executable FlashAttention: Q[64,64], K/V[128,64], two key blocks.
; Warp 0: TMA + MMA issuer. Warps 1..4: sixteen complete rows each.
; Unmasked/full tiles, fp16 Q/K/V/P, fp32 S/O/statistics. K/V prefetch overlaps MMA.
; See fa.launch.py for descriptors, constants, independent reference and census.
;
; Worker registers:
; r1 row, r2 column loop counter (the loop's setp), r3 stats pointer, r4/r5
; P addresses, r6 block (the loop's setp), r7 P base, r9 log2(e)/8, r10
; running max, r11 denominator, r12 new max, r13 alpha/inverse, r14 block
; sum, r15 scratch, r16..23 eight-column chunk, r24..29
; reduction/coefficient/packing scratch, r30/r31 O staging addresses
; (even/odd columns).
; Worker uniform registers: ur0/ur1 TMEM row/column (the acc coordinate
; pair), ur2 constants, ur3 score-ready, ur4 workers-done, ur5 PV-done
; (OUTPUT_DONE, the PV commit barrier), ur6 block parity, ur7 staged-output
; barrier.

.acc S, 0, 64, 64
.acc O, 4096, 64, 64
; Double-buffered K/V stage sets (roofline E3): TMA fills set 1 on port A
; while MMA reads set 0 on port B — the two async engines finally overlap.
.equ QBUF,       0
.equ KBUF0,      8192
.equ VBUF0,      16384
.equ KBUF1,      24576
.equ VBUF1,      32768
.equ PBUF,       40960
; Output staging reuses Q + K stage 0 (bytes 0..16383): sixteen 1024-byte
; fp32 xor64 slices. Workers write it only after waiting block 1's PV
; commit (OUTPUT_DONE parity 1); a commit arrives only once every earlier MMA
; command has retired, so no MMA read of Q (last: QK1) or K0 (last: QK0) is
; outstanding, and the only TMA loads into them (prologue) completed long ago.
; This ordering argument is what makes the reuse safe, and the shmem ownership
; sanitizer now checks it: an sts into a range a queued/active MMA or the TMA
; store still owns panics (trash/shmem-ownership-sanitizer-2026-10-03.md).
.equ OSTAGE,     0
.equ SCORE_DONE, 49160
.equ OUTPUT_DONE,49168
.equ WORK_DONE,  49176
.equ INPUT_DONE, 49184
.equ OSTAGE_DONE,49192
.equ OSTORE_DONE,49200
.equ CONSTANTS,  49216
.equ QDESC,      49664
.equ KDESC,      49728
.equ VDESC,      49792
.equ ODESC,      49984
.equ STATS,      50176

        usread ur0, WARP_ID
        ur2r  r0, ur0
        setp.eq p0, r0, 0
@p0     bra.uni ISSUER

; ---- row workers ----
        uaddi ur0, ur0, -1
        ushli ur0, ur0, 4          ; TMEM row base: 16 * (warp - 1)
        sread r0, LANE_ID
        ur2r  r1, ur0
        add   r1, r0, r1           ; row
        shli  r3, r1, 2
        addi  r3, r3, STATS
        umov  ur2, CONSTANTS
        lds.uni r9, [ur2]
        lds.uni r10, [ur2+4]       ; -infinity
        mov   r11, 0              ; denominator = 0.0
        mov   r6, 0
        umov  ur6, 0
        umov  ur3, SCORE_DONE
        umov  ur4, WORK_DONE
        umov  ur5, OUTPUT_DONE
; P pair-zero base for this row, computed in-kernel: PBUF + 16*row + 4*((row>>2)&1).
        shli  r7, r1, 4
        shri  r26, r1, 2
        andi  r26, r26, 1
        shli  r26, r26, 2
        add   r7, r7, r26
        addi  r7, r7, PBUF

WORK_BLOCK:
S_READY:
        mbar.try_wait p1, [ur3], ur6
@!p1    bra.uni S_READY

; Pass 1: row max. Keep only eight scores resident, not a whole row.
        lds.uni r12, [ur2+4]
        umov  ur1, 0
        mov   r2, 0
ROW_MAX:
        acc.ld.v8 r16, S, ur0
        fmax  r24, r16, r17
        fmax  r25, r18, r19
        fmax  r26, r20, r21
        fmax  r27, r22, r23
        fmax  r28, r24, r25
        fmax  r29, r26, r27
        fmax  r28, r28, r29
        fmax  r12, r12, r28
        uaddi ur1, ur1, 8
        addi  r2, r2, 8
        setp.lt p2, r2, 64
@p2     bra.uni ROW_MAX

; Positive scale lets max commute with score scaling. Maxima use base-2 units.
        addi  r25, r9, 0
        fmul  r12, r12, r25
        fmax  r12, r12, r10
        fsub  r13, r10, r12
        ex2   r13, r13             ; alpha = 2^(old_max - new_max)
        addi  r10, r12, 0
        mov   r14, 0
        umov  ur1, 0
        mov   r2, 0
        addi  r4, r7, 0           ; pair-zero address for this row, chunk zero

; Pass 2: exp(score - max), FP32 row sum, packed-half P in the MMA's xor64 layout.
MAKE_P:
        acc.ld.v8 r16, S, ur0
        addi  r24, r9, 0
        addi  r25, r9, 0
        fmul  r16, r16, r24
        fmul  r17, r17, r24
        fmul  r18, r18, r25
        fmul  r19, r19, r24
        fmul  r20, r20, r24
        fmul  r21, r21, r25
        fmul  r22, r22, r24
        fmul  r23, r23, r24
        addi  r24, r12, 0
        addi  r25, r12, 0
        fsub  r16, r16, r24
        fsub  r17, r17, r24
        fsub  r18, r18, r25
        fsub  r19, r19, r24
        fsub  r20, r20, r24
        fsub  r21, r21, r25
        fsub  r22, r22, r24
        fsub  r23, r23, r24
        ex2   r16, r16
        ex2   r17, r17
        ex2   r18, r18
        ex2   r19, r19
        ex2   r20, r20
        ex2   r21, r21
        ex2   r22, r22
        ex2   r23, r23
        fadd  r24, r16, r17
        fadd  r25, r18, r19
        fadd  r26, r20, r21
        fadd  r27, r22, r23
        fadd  r28, r24, r25
        fadd  r29, r26, r27
        fadd  r28, r28, r29
        fadd  r14, r14, r28
        cvt.pack.f16x2 r27, r16, r17
        sts   [r4], r27
        xori  r5, r4, 4
        cvt.pack.f16x2 r27, r18, r19
        sts   [r5], r27
        xori  r5, r4, 8
        cvt.pack.f16x2 r27, r20, r21
        sts   [r5], r27
        xori  r5, r4, 12
        cvt.pack.f16x2 r27, r22, r23
        sts   [r5], r27
        addi  r4, r4, 1024
        uaddi ur1, ur1, 8
        addi  r2, r2, 8
        setp.lt p2, r2, 64
@p2     bra.uni MAKE_P

        fmul  r11, r11, r13
        addi  r15, r14, 0
        fadd  r11, r11, r15
        sts   [r3], r10           ; per-block diagnostic row max
        sts   [r3+256], r11       ; denominator before final normalization
        sts   [r3+512], r13       ; alpha (zero for first block)
        addi  r3, r3, 1024
        setp.eq p2, r6, 0
@p2     bra.uni P_READY           ; first PV uses init; never read uninitialized O

; Correct the old FP32 numerator BEFORE accumulating this block's PV.
        umov  ur1, 0
        mov   r2, 0
        addi  r24, r13, 0
        addi  r25, r13, 0
CORRECT_O:
        acc.ld.v8 r16, O, ur0
        fmul  r16, r16, r24
        fmul  r17, r17, r24
        fmul  r18, r18, r25
        fmul  r19, r19, r24
        fmul  r20, r20, r24
        fmul  r21, r21, r25
        fmul  r22, r22, r24
        fmul  r23, r23, r24
        acc.st.v8 O, ur0, r16
        uaddi ur1, ur1, 8
        addi  r2, r2, 8
        setp.lt p2, r2, 64
@p2     bra.uni CORRECT_O

P_READY:
        mbar.arrive [ur4]         ; qtxc waits for this warp's sts + acc.st depbar
PV_READY:
        mbar.try_wait p1, [ur5], ur6
@!p1    bra.uni PV_READY
        addi  r6, r6, 1
        uaddi ur6, ur6, 1
        setp.lt p2, r6, 2
@p2     bra.uni WORK_BLOCK

; Final normalization, one row per lane, staged in shmem in the fp32 xor64
; layout (the same byte permutation as the operand tiles, four floats per
; 16-byte row) for one TMA store (an xor64 descriptor) of the whole tile:
;   addr(row, col) = OSTAGE + 1024*(col>>2) + 16*row + 4*((col&3) ^ ((row>>2)&1))
; With x = 4*((row>>2)&1): even columns sit at OSTAGE + 16*row + x (r30) and
; odd columns at that address XOR 4 (r31), plus 8*((col>>1)&1) + 1024*(col>>2).
; A column sts over 16 rows takes two bank rounds (rows r and r+8 share a bank).
; RF banks (reg mod 3): r30 is bank 0 and r31 bank 1; columns c+2 and c+3 are
; scaled into r26 (bank 2) and r27 (bank 0) so no sts names two same-bank regs.
        rcp   r13, r11
        addi  r24, r13, 0
        addi  r25, r13, 0
        umov  ur1, 0
        mov   r2, 0
        shli  r30, r1, 4
        shri  r26, r1, 2
        andi  r26, r26, 1
        shli  r26, r26, 2
        add   r30, r30, r26
        addi  r30, r30, OSTAGE    ; even-column base for chunk 0
        xori  r31, r30, 4         ; odd-column base for chunk 0
        umov  ur7, OSTAGE_DONE
NORMALIZE:
        acc.ld.v8 r16, O, ur0
        fmul  r16, r16, r24
        fmul  r17, r17, r24
        fmul  r26, r18, r25
        fmul  r27, r19, r24
        fmul  r20, r20, r24
        fmul  r21, r21, r25
        fmul  r22, r22, r24
        fmul  r23, r23, r24
        sts   [r30], r16          ; col c
        sts   [r31], r17          ; col c+1
        sts   [r30+8], r26        ; col c+2
        sts   [r31+8], r27        ; col c+3
        sts   [r30+1024], r20     ; col c+4 (next object)
        sts   [r31+1024], r21     ; col c+5
        sts   [r30+1032], r22     ; col c+6
        sts   [r31+1032], r23     ; col c+7
        addi  r30, r30, 2048
        addi  r31, r31, 2048
        uaddi ur1, ur1, 8
        addi  r2, r2, 8
        setp.lt p2, r2, 64
@p2     bra.uni NORMALIZE

        mbar.arrive [ur7]         ; qtxc waits for this warp's sts depbar
        halt

; ---- issuer: two unrolled blocks; block 1's inputs prefetch under block 0 ----
ISSUER:
; Issuer uniform registers: ur0 / ur1 the MMA A / B addresses, ur2
; INPUT_DONE, ur3 SCORE_DONE, ur4 WORK_DONE, ur5 OUTPUT_DONE, ur6 OSTAGE_DONE,
; ur7 OSTORE_DONE; the TMA's: ur8 / ur9 the tile's coordinates (c0 the head
; channel, c1 the row: 0, or 64 for block 1's keys), ur10 .. ur14 the stage
; buffers (Q, K0, V0, K1, V1), ur15 the output staging buffer.
        umov  ur2, INPUT_DONE
        umov  ur8, 0
        umov  ur9, 0
        umov  ur10, QBUF
        umov  ur11, KBUF0
        umov  ur12, VBUF0
        umov  ur3, SCORE_DONE
        umov  ur4, WORK_DONE
        umov  ur5, OUTPUT_DONE
; Prologue: Q and block 0's K/V land together — one barrier round trip.
        mbar.arrive.expect_tx [ur2], 24576
        tma.load.2d [ur10], [QDESC, ur8], [ur2]
        tma.load.2d [ur11], [KDESC, ur8], [ur2]
        tma.load.2d [ur12], [VDESC, ur8], [ur2]
        umov  ur13, KBUF1
        umov  ur14, VBUF1
        umov  ur15, OSTAGE
IN0:
        mbar.try_wait p1, [ur2], 0
@!p1    bra.uni IN0
; Prefetch block 1 into stage set 1: port A fills while MMA reads set 0.
        umov  ur9, 64
        mbar.arrive.expect_tx [ur2], 16384
        tma.load.2d [ur13], [KDESC, ur8], [ur2]
        tma.load.2d [ur14], [VDESC, ur8], [ur2]
        umov  ur9, 0

        umov  ur0, QBUF
        umov  ur1, KBUF0
        mma.async.init.m64n64k8 S, [ur0], [ur1]
        uaddi ur0, ur0, 1024
        uaddi ur1, ur1, 1024
        mma.async.m64n64k8 S, [ur0], [ur1]
        uaddi ur0, ur0, 1024
        uaddi ur1, ur1, 1024
        mma.async.m64n64k8 S, [ur0], [ur1]
        uaddi ur0, ur0, 1024
        uaddi ur1, ur1, 1024
        mma.async.m64n64k8 S, [ur0], [ur1]
        uaddi ur0, ur0, 1024
        uaddi ur1, ur1, 1024
        mma.async.m64n64k8 S, [ur0], [ur1]
        uaddi ur0, ur0, 1024
        uaddi ur1, ur1, 1024
        mma.async.m64n64k8 S, [ur0], [ur1]
        uaddi ur0, ur0, 1024
        uaddi ur1, ur1, 1024
        mma.async.m64n64k8 S, [ur0], [ur1]
        uaddi ur0, ur0, 1024
        uaddi ur1, ur1, 1024
        mma.async.m64n64k8 S, [ur0], [ur1]
        mma.commit [ur3]
W0:
        mbar.try_wait p1, [ur4], 0
@!p1    bra.uni W0

        umov  ur0, PBUF
        umov  ur1, VBUF0
        mma.async.init.m64n64k8 O, [ur0], [ur1]
        uaddi ur0, ur0, 1024
        uaddi ur1, ur1, 1024
        mma.async.m64n64k8 O, [ur0], [ur1]
        uaddi ur0, ur0, 1024
        uaddi ur1, ur1, 1024
        mma.async.m64n64k8 O, [ur0], [ur1]
        uaddi ur0, ur0, 1024
        uaddi ur1, ur1, 1024
        mma.async.m64n64k8 O, [ur0], [ur1]
        uaddi ur0, ur0, 1024
        uaddi ur1, ur1, 1024
        mma.async.m64n64k8 O, [ur0], [ur1]
        uaddi ur0, ur0, 1024
        uaddi ur1, ur1, 1024
        mma.async.m64n64k8 O, [ur0], [ur1]
        uaddi ur0, ur0, 1024
        uaddi ur1, ur1, 1024
        mma.async.m64n64k8 O, [ur0], [ur1]
        uaddi ur0, ur0, 1024
        uaddi ur1, ur1, 1024
        mma.async.m64n64k8 O, [ur0], [ur1]
        mma.commit [ur5]
; Block 1: data long since prefetched; QK(1) queues behind PV(0)'s commit
; fence and the engine flows through with no issuer round trip.
IN1:
        mbar.try_wait p1, [ur2], 1
@!p1    bra.uni IN1
        umov  ur0, QBUF
        umov  ur1, KBUF1
        mma.async.init.m64n64k8 S, [ur0], [ur1]
        uaddi ur0, ur0, 1024
        uaddi ur1, ur1, 1024
        mma.async.m64n64k8 S, [ur0], [ur1]
        uaddi ur0, ur0, 1024
        uaddi ur1, ur1, 1024
        mma.async.m64n64k8 S, [ur0], [ur1]
        uaddi ur0, ur0, 1024
        uaddi ur1, ur1, 1024
        mma.async.m64n64k8 S, [ur0], [ur1]
        uaddi ur0, ur0, 1024
        uaddi ur1, ur1, 1024
        mma.async.m64n64k8 S, [ur0], [ur1]
        uaddi ur0, ur0, 1024
        uaddi ur1, ur1, 1024
        mma.async.m64n64k8 S, [ur0], [ur1]
        uaddi ur0, ur0, 1024
        uaddi ur1, ur1, 1024
        mma.async.m64n64k8 S, [ur0], [ur1]
        uaddi ur0, ur0, 1024
        uaddi ur1, ur1, 1024
        mma.async.m64n64k8 S, [ur0], [ur1]
        mma.commit [ur3]
W1:
        mbar.try_wait p1, [ur4], 1
@!p1    bra.uni W1
        umov  ur0, PBUF
        umov  ur1, VBUF1
        mma.async.m64n64k8 O, [ur0], [ur1]
        uaddi ur0, ur0, 1024
        uaddi ur1, ur1, 1024
        mma.async.m64n64k8 O, [ur0], [ur1]
        uaddi ur0, ur0, 1024
        uaddi ur1, ur1, 1024
        mma.async.m64n64k8 O, [ur0], [ur1]
        uaddi ur0, ur0, 1024
        uaddi ur1, ur1, 1024
        mma.async.m64n64k8 O, [ur0], [ur1]
        uaddi ur0, ur0, 1024
        uaddi ur1, ur1, 1024
        mma.async.m64n64k8 O, [ur0], [ur1]
        uaddi ur0, ur0, 1024
        uaddi ur1, ur1, 1024
        mma.async.m64n64k8 O, [ur0], [ur1]
        uaddi ur0, ur0, 1024
        uaddi ur1, ur1, 1024
        mma.async.m64n64k8 O, [ur0], [ur1]
        uaddi ur0, ur0, 1024
        uaddi ur1, ur1, 1024
        mma.async.m64n64k8 O, [ur0], [ur1]
        mma.commit [ur5]
; Epilogue: the four workers stage normalized O (16 KiB) into OSTAGE; one TMA
; store writes it to gmem. The store's mbar certifies that the shmem source
; was consumed; the kernel-end drain retires the gmem writes.
        umov  ur6, OSTAGE_DONE
STAGED:
        mbar.try_wait p1, [ur6], 0
@!p1    bra.uni STAGED
        umov  ur7, OSTORE_DONE
        mbar.arrive.expect_tx [ur7], 16384
        tma.store.2d [ODESC, ur8], [ur15], [ur7]
STORED:
        mbar.try_wait p1, [ur7], 0
@!p1    bra.uni STORED
        halt
