; FlashAttention: two 32-row query tiles, each attending to two 64-key blocks.
; Warp 0 issues TMA and MMA. Warps 1/2 own Q rows 0..31, warps 3/4 own 32..63.
; Unmasked/full tiles, fp16 Q/K/V/P, fp32 S/O/statistics. K/V prefetch overlaps MMA.
; See fa.launch.py for the four descriptor arguments, the independent reference and the census.
;
; Worker registers:
; r0 the unshuffled address of the current 16- or 32-byte chunk (P, then the
; staged O), r1 row, r3 stats pointer, r4/r5 P addresses, r7 the row's P
; base, r8 the row's shuffle constant, r9 log2(e)/8, r10 running max, r11
; denominator, r12 new max, r13 alpha/inverse, r14 block sum, r15 scratch,
; r16..23 eight-column chunk, r24..29 reduction/coefficient/packing
; scratch; in the final normalization r6/r28/r4/r5 are the O staging
; addresses (r28's scratch use is over by then). The loops count in uniform
; registers (usetp): the column in ur1, the block in ur6.
;
; P and the staged O are swizzle64 tiles (src/layout.hpp): row r whole at
; base + r x spacing (128 bytes for P, 256 for O), and inside the row byte b
; at b XOR the row's constant ((r & 3) << 4 | (r & 12)): the 16-byte piece's
; slot XOR r & 3, the word's XOR (r / 4) & 3. One constant per row serves
; both tiles (rows of 64 bytes or more). The rule takes the row number from
; the address (base / spacing + r); counting r from the tile agrees because
; PBUF0 and OSTAGE0 are multiples of 16 rows (2048 and 4096 bytes).
; A worker's tmem pointers (src/layout.hpp): ur0 its 16 score rows (S_TMEM +
; 64 x its first query row), ur11 the same rows of O; ur1 walks one of them
; eight columns at a time and stops at ur10 / ur12 (the row's end). The upper
; query tile's workers use the next barrier in each pair. ur6 is the key
; block and the parity of its score, work and PV barriers.

; tmem, in words: the scores of all 64 query rows at S_TMEM and the output
; numerator at O_TMEM, rows of 64 words. Each 32-row tile is one matmul's
; m32n64 result: S0 = S_TMEM, S1 = S1_TMEM (query rows 32..63), O0, O1 the
; same. A worker points at its own rows, so both tiles share the worker code.
.equ S_TMEM,     0
.equ S1_TMEM,    2048
.equ O_TMEM,     4096
.equ O1_TMEM,    6144
; Double-buffered K/V stage sets (roofline E3): TMA fills set 1 on port A
; while MMA reads set 0 on port B — the two async engines finally overlap.
.equ QBUF0,      0
.equ QBUF1,      4096
.equ KBUF0,      8192
.equ VBUF0,      16384
.equ KBUF1,      24576
.equ VBUF1,      32768
.equ PBUF0,      40960
.equ PBUF1,      45056
; The last QK for both tiles precedes the last PV for either. After its PV
; commit each worker pair can stage 32 fp32 rows over the dead Q or K0.
.equ OSTAGE0,    0
.equ OSTAGE1,    8192
.equ STATS,      50176

; What the launch gives: one TMA descriptor per tensor (Q and O move 32 rows
; at a time, K and V a 64-key block; V transposed). Everything below it is the
; kernel's own: five warps, its barriers and its two constants.
.warps  5
.param  desc QDESC
.param  desc KDESC
.param  desc VDESC
.param  desc ODESC
; SCORE and OUTPUT count the issuer's MMA commits; WORK and STAGED the two
; workers that own each query tile.
.mbar SCORE0,      expect 1
.mbar SCORE1,      expect 1
.mbar WORK0,       expect 2
.mbar WORK1,       expect 2
.mbar OUTPUT0,     expect 1
.mbar OUTPUT1,     expect 1
.mbar STAGED0,     expect 2
.mbar STAGED1,     expect 2
.mbar INPUT_DONE,  expect 1
.mbar OSTORE_DONE, expect 1
.data CONSTANTS, f32 0.180336878, -inf      ; log2(e) / sqrt(64), -infinity

        usread ur0, WARP_ID
        usetp.eq.u32 p0, ur0, 0
@p0     bra.uni ISSUER

; ---- row workers ----
        uaddi ur0, ur0, -1
        ushri ur8, ur0, 1
        ushli ur8, ur8, 3          ; offset of this tile's barriers: 0 or 8
        ushli ur1, ur0, 4          ; global row group: 0, 16, 32 or 48
        sread r0, LANE_ID
        ur2r  r1, ur1
        ushli ur0, ur1, 6          ; this row group's scores: S_TMEM (0) + 64 x row group
        add   r1, r0, r1           ; global row for P, statistics and staged O
        shli  r3, r1, 2
        addi  r3, r3, STATS
        umov  ur2, CONSTANTS
        lds.uni r9, [ur2]
        lds.uni r10, [ur2+4]       ; -infinity
        mov   r11, 0              ; denominator = 0.0
        umov  ur6, 0
        uaddi ur3, ur8, SCORE0
        uaddi ur4, ur8, WORK0
        uaddi ur5, ur8, OUTPUT0
        uaddi ur7, ur8, STAGED0
        uaddi ur10, ur0, 64        ; the end of the score rows' columns
        uaddi ur11, ur0, O_TMEM    ; the same rows of O
        uaddi ur12, ur11, 64
; This row's P base and its shuffle constant (r & 3) << 4 | (r & 12).
        shli  r7, r1, 7
        addi  r7, r7, PBUF0
        andi  r8, r1, 3
        shli  r8, r8, 4
        andi  r27, r1, 12
        or    r8, r8, r27

WORK_BLOCK:
S_READY:
        mbar.try_wait p1, [ur3], ur6
@!p1    bra.uni S_READY

; Pass 1: row max. Keep only eight scores resident, not a whole row.
        lds.uni r12, [ur2+4]
        umov  ur1, ur0
ROW_MAX:
        acc.ld.v8 r16, [ur1, 64]
        fmax  r24, r16, r17
        fmax  r25, r18, r19
        fmax  r26, r20, r21
        fmax  r27, r22, r23
        fmax  r28, r24, r25
        fmax  r29, r26, r27
        fmax  r28, r28, r29
        fmax  r12, r12, r28
        uaddi ur1, ur1, 8
        usetp.lt.u32 p2, ur1, ur10
@p2     bra.uni ROW_MAX

; Positive scale lets max commute with score scaling. Maxima use base-2 units.
        addi  r25, r9, 0
        fmul  r12, r12, r25
        fmax  r12, r12, r10
        fsub  r13, r10, r12
        ex2   r13, r13             ; alpha = 2^(old_max - new_max)
        addi  r10, r12, 0
        mov   r14, 0
        umov  ur1, ur0
        addi  r0, r7, 0           ; chunk zero of this row, unshuffled

; Pass 2: exp(score - max), FP32 row sum, packed-half P in the swizzle64
; layout the MMA reads (one 16-byte piece per chunk of eight columns).
MAKE_P:
        acc.ld.v8 r16, [ur1, 64]
        addi  r24, r9, 0
        addi  r25, r9, 0
        fmul  r16, r16, r24
        fmul  r17, r17, r24
        fmul  r18, r18, r25
        fmul  r19, r19, r24
        fmul  r20, r20, r24
        fmul  r21, r21, r25
        fmul  r22, r22, r24
        fmul  r23, r23, r24
        addi  r24, r12, 0
        addi  r25, r12, 0
        fsub  r16, r16, r24
        fsub  r17, r17, r24
        fsub  r18, r18, r25
        fsub  r19, r19, r24
        fsub  r20, r20, r24
        fsub  r21, r21, r25
        fsub  r22, r22, r24
        fsub  r23, r23, r24
        ex2   r16, r16
        ex2   r17, r17
        ex2   r18, r18
        ex2   r19, r19
        ex2   r20, r20
        ex2   r21, r21
        ex2   r22, r22
        ex2   r23, r23
        fadd  r24, r16, r17
        fadd  r25, r18, r19
        fadd  r26, r20, r21
        fadd  r27, r22, r23
        fadd  r28, r24, r25
        fadd  r29, r26, r27
        fadd  r28, r28, r29
        fadd  r14, r14, r28
        xor   r4, r0, r8          ; the chunk's word 0 (its four words: r4 XOR 0, 4, 8, 12)
        cvt.pack.f16x2 r27, r16, r17
        sts   [r4], r27
        xori  r5, r4, 4
        cvt.pack.f16x2 r27, r18, r19
        sts   [r5], r27
        xori  r5, r4, 8
        cvt.pack.f16x2 r27, r20, r21
        sts   [r5], r27
        xori  r5, r4, 12
        cvt.pack.f16x2 r27, r22, r23
        sts   [r5], r27
        addi  r0, r0, 16
        uaddi ur1, ur1, 8
        usetp.lt.u32 p2, ur1, ur10
@p2     bra.uni MAKE_P

        fmul  r11, r11, r13
        addi  r15, r14, 0
        fadd  r11, r11, r15
        sts   [r3], r10           ; per-block diagnostic row max
        sts   [r3+256], r11       ; denominator before final normalization
        sts   [r3+512], r13       ; alpha (zero for first block)
        addi  r3, r3, 1024
        usetp.eq.u32 p2, ur6, 0
@p2     bra.uni P_READY           ; first PV uses init; never read uninitialized O

; Correct the old FP32 numerator BEFORE accumulating this block's PV.
        umov  ur1, ur11
        addi  r24, r13, 0
        addi  r25, r13, 0
CORRECT_O:
        acc.ld.v8 r16, [ur1, 64]
        fmul  r16, r16, r24
        fmul  r17, r17, r24
        fmul  r18, r18, r25
        fmul  r19, r19, r24
        fmul  r20, r20, r24
        fmul  r21, r21, r25
        fmul  r22, r22, r24
        fmul  r23, r23, r24
        acc.st.v8 [ur1, 64], r16
        uaddi ur1, ur1, 8
        usetp.lt.u32 p2, ur1, ur12
@p2     bra.uni CORRECT_O

P_READY:
        mbar.arrive [ur4]         ; qtxc waits for this warp's sts + acc.st depbar
PV_READY:
        mbar.try_wait p1, [ur5], ur6
@!p1    bra.uni PV_READY
        uaddi ur6, ur6, 1
        usetp.lt.u32 p2, ur6, 2
@p2     bra.uni WORK_BLOCK

; Final normalization, one row per lane, staged in shmem as an fp32
; swizzle64 tile (256-byte rows) for one TMA store per worker pair:
;   addr(row, col) = OSTAGE0 + 256*row + ((4*col) XOR r8)
; A chunk of eight columns is 32 unshuffled bytes at r0 (OSTAGE0 + 256*row +
; 32*chunk); its column j is at (r0 XOR r8) XOR 4j. A column sts over 16 rows
; takes one bank round. RF banks (reg mod 3): the addresses r6 (bank 0),
; r28 / r4 (bank 1) and r5 (bank 2) are paired with values of other banks;
; columns c+2 and c+3 are scaled into r26 (bank 2) and r27 (bank 0).
        rcp   r13, r11
        addi  r24, r13, 0
        addi  r25, r13, 0
        umov  ur1, ur11
        shli  r0, r1, 8
        addi  r0, r0, OSTAGE0     ; chunk zero of this row, unshuffled
NORMALIZE:
        acc.ld.v8 r16, [ur1, 64]
        fmul  r16, r16, r24
        fmul  r17, r17, r24
        fmul  r26, r18, r25
        fmul  r27, r19, r24
        fmul  r20, r20, r24
        fmul  r21, r21, r25
        fmul  r22, r22, r24
        fmul  r23, r23, r24
        xor   r6, r0, r8          ; col c
        sts   [r6], r16
        xori  r28, r6, 4          ; col c+1
        sts   [r28], r17
        xori  r4, r6, 8           ; col c+2
        sts   [r4], r26
        xori  r5, r6, 12          ; col c+3
        sts   [r5], r27
        xori  r28, r6, 16         ; col c+4 (the next 16-byte piece)
        sts   [r28], r20
        xori  r4, r6, 20          ; col c+5
        sts   [r4], r21
        xori  r5, r6, 24          ; col c+6
        sts   [r5], r22
        xori  r28, r6, 28         ; col c+7
        sts   [r28], r23
        addi  r0, r0, 32
        uaddi ur1, ur1, 8
        usetp.lt.u32 p2, ur1, ur12
@p2     bra.uni NORMALIZE

        mbar.arrive [ur7]         ; qtxc waits for this warp's sts depbar
        halt

; ---- issuer: one K/V stage per key block, shared by both query tiles ----
ISSUER:
        umov  ur2, INPUT_DONE
        umov  ur8, 0               ; TMA coordinates (channel, row)
        umov  ur9, 0
        umov  ur10, QBUF0
        umov  ur11, KBUF0          ; current K and V for both query tiles
        umov  ur12, VBUF0
        mbar.arrive.expect_tx [ur2], 24576
        tma.load.2d [ur10], [QDESC, ur8], [ur2]
        umov  ur10, QBUF1
        umov  ur9, 32
        tma.load.2d [ur10], [QDESC, ur8], [ur2]
        umov  ur9, 0
        tma.load.2d [ur11], [KDESC, ur8], [ur2]
        tma.load.2d [ur12], [VDESC, ur8], [ur2]

        umov  ur3, SCORE0
        umov  ur4, SCORE1
        umov  ur5, WORK0
        umov  ur6, WORK1
        umov  ur7, OUTPUT0
        umov  ur15, OUTPUT1
        umov  ur16, 0              ; key block, also the workers' barrier parity
        umov  ur13, KBUF1
        umov  ur14, VBUF1
        umov  ur17, S_TMEM         ; the four 32x64 results: S0, S1, O0, O1
        umov  ur18, S1_TMEM
        umov  ur19, O_TMEM
        umov  ur20, O1_TMEM
IN0:
        mbar.try_wait p1, [ur2], 0
@!p1    bra.uni IN0
; Prefetch the second K/V stage while MMA and the workers use the first.
        umov  ur9, 64
        mbar.arrive.expect_tx [ur2], 16384
        tma.load.2d [ur13], [KDESC, ur8], [ur2]
        tma.load.2d [ur14], [VDESC, ur8], [ur2]

KEY_BLOCK:
        usetp.eq.u32 p2, ur16, 0
; Each command consumes eight fp16 values per row. The next K slice is
; 16 bytes farther along each 128-byte row. Commit S0 as soon as it is ready:
; warps 1/2 can run softmax while the tensor core computes S1.
        umov  ur0, QBUF0
        umov  ur1, ur11
        mma.async.init.m32n64k8 [ur17], [ur0, 128], [ur1, 128]
        uaddi ur0, ur0, 16
        uaddi ur1, ur1, 16
        mma.async.m32n64k8 [ur17], [ur0, 128], [ur1, 128]
        uaddi ur0, ur0, 16
        uaddi ur1, ur1, 16
        mma.async.m32n64k8 [ur17], [ur0, 128], [ur1, 128]
        uaddi ur0, ur0, 16
        uaddi ur1, ur1, 16
        mma.async.m32n64k8 [ur17], [ur0, 128], [ur1, 128]
        uaddi ur0, ur0, 16
        uaddi ur1, ur1, 16
        mma.async.m32n64k8 [ur17], [ur0, 128], [ur1, 128]
        uaddi ur0, ur0, 16
        uaddi ur1, ur1, 16
        mma.async.m32n64k8 [ur17], [ur0, 128], [ur1, 128]
        uaddi ur0, ur0, 16
        uaddi ur1, ur1, 16
        mma.async.m32n64k8 [ur17], [ur0, 128], [ur1, 128]
        uaddi ur0, ur0, 16
        uaddi ur1, ur1, 16
        mma.async.m32n64k8 [ur17], [ur0, 128], [ur1, 128]
        mma.commit [ur3]

        umov  ur0, QBUF1
        umov  ur1, ur11
        mma.async.init.m32n64k8 [ur18], [ur0, 128], [ur1, 128]
        uaddi ur0, ur0, 16
        uaddi ur1, ur1, 16
        mma.async.m32n64k8 [ur18], [ur0, 128], [ur1, 128]
        uaddi ur0, ur0, 16
        uaddi ur1, ur1, 16
        mma.async.m32n64k8 [ur18], [ur0, 128], [ur1, 128]
        uaddi ur0, ur0, 16
        uaddi ur1, ur1, 16
        mma.async.m32n64k8 [ur18], [ur0, 128], [ur1, 128]
        uaddi ur0, ur0, 16
        uaddi ur1, ur1, 16
        mma.async.m32n64k8 [ur18], [ur0, 128], [ur1, 128]
        uaddi ur0, ur0, 16
        uaddi ur1, ur1, 16
        mma.async.m32n64k8 [ur18], [ur0, 128], [ur1, 128]
        uaddi ur0, ur0, 16
        uaddi ur1, ur1, 16
        mma.async.m32n64k8 [ur18], [ur0, 128], [ur1, 128]
        uaddi ur0, ur0, 16
        uaddi ur1, ur1, 16
        mma.async.m32n64k8 [ur18], [ur0, 128], [ur1, 128]
        mma.commit [ur4]

; Each pair publishes its P and corrected O independently. Block 0 initializes
; the numerator. Block 1 adds to the FP32 numerator scaled by that pair.
P0_READY:
        mbar.try_wait p1, [ur5], ur16
@!p1    bra.uni P0_READY
        umov  ur0, PBUF0
        umov  ur1, ur12
@!p2    bra.uni ADD_O0
        mma.async.init.m32n64k8 [ur19], [ur0, 128], [ur1, 128]
        bra   MORE_O0
ADD_O0: mma.async.m32n64k8 [ur19], [ur0, 128], [ur1, 128]
MORE_O0:
        uaddi ur0, ur0, 16
        uaddi ur1, ur1, 16
        mma.async.m32n64k8 [ur19], [ur0, 128], [ur1, 128]
        uaddi ur0, ur0, 16
        uaddi ur1, ur1, 16
        mma.async.m32n64k8 [ur19], [ur0, 128], [ur1, 128]
        uaddi ur0, ur0, 16
        uaddi ur1, ur1, 16
        mma.async.m32n64k8 [ur19], [ur0, 128], [ur1, 128]
        uaddi ur0, ur0, 16
        uaddi ur1, ur1, 16
        mma.async.m32n64k8 [ur19], [ur0, 128], [ur1, 128]
        uaddi ur0, ur0, 16
        uaddi ur1, ur1, 16
        mma.async.m32n64k8 [ur19], [ur0, 128], [ur1, 128]
        uaddi ur0, ur0, 16
        uaddi ur1, ur1, 16
        mma.async.m32n64k8 [ur19], [ur0, 128], [ur1, 128]
        uaddi ur0, ur0, 16
        uaddi ur1, ur1, 16
        mma.async.m32n64k8 [ur19], [ur0, 128], [ur1, 128]
        mma.commit [ur7]

P1_READY:
        mbar.try_wait p1, [ur6], ur16
@!p1    bra.uni P1_READY
        umov  ur0, PBUF1
        umov  ur1, ur12
@!p2    bra.uni ADD_O1
        mma.async.init.m32n64k8 [ur20], [ur0, 128], [ur1, 128]
        bra   MORE_O1
ADD_O1: mma.async.m32n64k8 [ur20], [ur0, 128], [ur1, 128]
MORE_O1:
        uaddi ur0, ur0, 16
        uaddi ur1, ur1, 16
        mma.async.m32n64k8 [ur20], [ur0, 128], [ur1, 128]
        uaddi ur0, ur0, 16
        uaddi ur1, ur1, 16
        mma.async.m32n64k8 [ur20], [ur0, 128], [ur1, 128]
        uaddi ur0, ur0, 16
        uaddi ur1, ur1, 16
        mma.async.m32n64k8 [ur20], [ur0, 128], [ur1, 128]
        uaddi ur0, ur0, 16
        uaddi ur1, ur1, 16
        mma.async.m32n64k8 [ur20], [ur0, 128], [ur1, 128]
        uaddi ur0, ur0, 16
        uaddi ur1, ur1, 16
        mma.async.m32n64k8 [ur20], [ur0, 128], [ur1, 128]
        uaddi ur0, ur0, 16
        uaddi ur1, ur1, 16
        mma.async.m32n64k8 [ur20], [ur0, 128], [ur1, 128]
        uaddi ur0, ur0, 16
        uaddi ur1, ur1, 16
        mma.async.m32n64k8 [ur20], [ur0, 128], [ur1, 128]
        mma.commit [ur15]

@!p2    bra.uni WRITE_OUTPUT
        umov  ur16, 1
        umov  ur11, ur13
        umov  ur12, ur14
IN1:
        mbar.try_wait p1, [ur2], 1
@!p1    bra.uni IN1
        bra   KEY_BLOCK

; Each pair stages 32 fp32 rows. Start draining the first tile while the
; second pair can still be normalizing. Both stores credit the same 16 KiB.
WRITE_OUTPUT:
        umov  ur3, STAGED0
        umov  ur4, STAGED1
        umov  ur5, OSTORE_DONE
        umov  ur10, OSTAGE0
        umov  ur11, OSTAGE1
        umov  ur9, 0
        mbar.arrive.expect_tx [ur5], 16384
WAIT_STAGE0:
        mbar.try_wait p1, [ur3], 0
@!p1    bra.uni WAIT_STAGE0
        tma.store.2d [ODESC, ur8], [ur10], [ur5]
        umov  ur9, 32
WAIT_STAGE1:
        mbar.try_wait p1, [ur4], 0
@!p1    bra.uni WAIT_STAGE1
        tma.store.2d [ODESC, ur8], [ur11], [ur5]
STORED:
        mbar.try_wait p1, [ur5], 0
@!p1    bra.uni STORED
        halt
