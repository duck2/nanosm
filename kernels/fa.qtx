; FlashAttention: two 32-row query tiles, each attending to two 64-key blocks.
; Warp 0 issues TMA and MMA. Warps 1/2 own Q rows 0..31, warps 3/4 own 32..63.
; Unmasked/full tiles, fp16 Q/K/V/P, fp32 S/O/statistics. K/V prefetch overlaps MMA.
; See fa.launch.py for the four descriptor arguments, the independent reference and the census.
;
; A worker does 16 query rows, a row per lane: %row is the lane's query row,
; %col0 .. %col7 an eight-column chunk of it (a group: acc.ld.v8 fills eight
; neighbours), %max / %denom its running max and denominator. The loops
; count in uniform registers (usetp): the column in %walk, the block in
; %block.
;
; P and the staged O are swizzle64 tiles (src/layout.hpp): row r whole at
; base + r x spacing (128 bytes for P, 256 for O), and inside the row byte b
; at b XOR the row's constant ((r & 3) << 4 | (r & 12)): the 16-byte piece's
; slot XOR r & 3, the word's XOR (r / 4) & 3. One constant per row serves
; both tiles (rows of 64 bytes or more). The rule takes the row number from
; the address (base / spacing + r); counting r from the tile agrees because
; PBUF and OSTAGE are declared on 16-row multiples (their align=).
; A worker's tmem pointers (src/layout.hpp): %s_rows its 16 score rows
; (S + S.row_words x its first query row), %o_rows the same rows of O; %walk
; walks one of them eight columns at a time and stops at %s_end / %o_end
; (the row's end). The upper query tile's workers use the next barrier in
; each pair. %block is the key block and the parity of its score, work and
; PV barriers.

; The kernel's own memory, by name (README "Memory"): qtxc places each object,
; one after another from address 0; the code uses the names, their elements
; (QBUF[1]) and their properties (.row_bytes, .stride, .bytes).
;
; tmem, in words: the scores S and the output numerator O, each two tiles of
; 32 rows of 64 words (one matmul's m32n64 result per query tile). A worker
; points at its own rows, so both tiles share the worker code: query row r's
; scores are at S + r x S.row_words, tile 1's rows following tile 0's.
.tmem  S[2],      rows=32, cols=64
.tmem  O[2],      rows=32, cols=64
; Double-buffered K/V stage sets (roofline E3): TMA fills set 1 on port A
; while MMA reads set 0 on port B -- the two async engines finally overlap.
.shmem QBUF[2],   rows=32, cols=64, elem=2   ; Q, query tile t
.shmem KBUF[2],   rows=64, cols=64, elem=2   ; K, stage set (key block) b
.shmem VBUF[2],   rows=64, cols=64, elem=2   ; V, the same, transposed
; P, query tile t (both key blocks use it in turn). The workers shuffle a
; row's bytes themselves with one constant per row; that needs a base on a
; multiple of 16 rows, which these tiles ask for.
.shmem PBUF[2],   rows=32, cols=64, elem=2, align=16 * PBUF.row_bytes
; The last QK for both tiles precedes the last PV for either. After its PV
; commit each worker pair can stage 32 fp32 rows OVER the dead Q or K0.
.shmem OSTAGE[2], rows=32, cols=64, elem=4, align=16 * OSTAGE.row_bytes, over=QBUF, KBUF[0]
; Per key block: three fields (row max, denominator, alpha) of 64 query rows.
.shmem STATS[2],  bytes=1024, align=4
.equ   STAT_FIELD, 64 * 4            ; one field: a fp32 per query row

; What the launch gives: one TMA descriptor per tensor (Q and O move 32 rows
; at a time, K and V a 64-key block; V transposed): the four .param lines, in
; that order, are the kernel's signature. Everything else below is the
; kernel's own: five warps and its barriers (its two float constants are umov immediates).
; Together, in the order written, these lines are the launch block, the first
; declared arriving first (README "Launch"): the issuer's first act is an
; arrive on INPUT_DONE and a load through QDESC, so those come first. A pair
; of barriers is an array (`.mbar NAME[2]`: NAME[1] is 8 bytes after NAME[0],
; and the workers reach it as NAME + 8 t); an array arrives whole.
; SCORE and OUTPUT count the issuer's MMA commits; WORK and STAGED the two
; workers that own each query tile.
.warps  5
.param  desc QDESC
.mbar INPUT_DONE,  expect 1
.mbar SCORE[2],    expect 1
.mbar WORK[2],     expect 2
.mbar OUTPUT[2],   expect 1
.mbar STAGED[2],   expect 2
.mbar OSTORE_DONE, expect 1
.param  desc KDESC
.param  desc VDESC
.param  desc ODESC
.reg   %col<8>
.ureg  %coord<2>

        usread %warp, WARP_ID
        usetp.eq.u32 p0, %warp, 0
@p0     bra.uni ISSUER

; ---- row workers ----
        uaddi %w, %warp, -1
        ushri %tile8, %w, 1
        ushli %tile8, %tile8, 3   ; offset of this tile's barriers: 0 or 8
        ushli %first_row, %w, 4   ; global row group: 0, 16, 32 or 48
        sread %lane, LANE_ID
        ur2r  %row, %first_row
        ushli %rows_at, %first_row, log2(S.row_words) ; this row group, as a word offset into S or O
        uaddi %s_rows, %rows_at, S ; this row group's scores
        add   %row, %lane, %row   ; global row for P, statistics and staged O
        shli  %stats, %row, 2
        addi  %stats, %stats, STATS
        umov  %scale_bits, 0.180336878 ; log2(e) / sqrt(64): a constant is a umov, no memory
        umov  %neg_inf_bits, -inf
        ur2r  %scale, %scale_bits
        ur2r  %max, %neg_inf_bits ; -infinity
        mov   %denom, 0           ; denominator = 0.0
        umov  %block, 0
        uaddi %score_bar, %tile8, SCORE
        uaddi %work_bar, %tile8, WORK
        uaddi %output_bar, %tile8, OUTPUT
        uaddi %staged_bar, %tile8, STAGED
        uaddi %s_end, %s_rows, S.row_words ; the end of the score rows' columns
        uaddi %o_rows, %rows_at, O ; the same rows of O
        uaddi %o_end, %o_rows, O.row_words
; This row's P base and its shuffle constant (r & 3) << 4 | (r & 12).
        shli  %p_row, %row, log2(PBUF.row_bytes)
        addi  %p_row, %p_row, PBUF
        andi  %shuffle, %row, 3
        shli  %shuffle, %shuffle, 4
        andi  %tmp, %row, 12
        or    %shuffle, %shuffle, %tmp

WORK_BLOCK:
S_READY:
        mbar.try_wait p1, [%score_bar], %block
@!p1    bra.uni S_READY

; Pass 1: row max. Keep only eight scores resident, not a whole row.
        ur2r  %new_max, %neg_inf_bits ; -infinity
        umov  %walk, %s_rows
ROW_MAX:
        acc.ld.v8 %col0, [%walk, S.row_words]
        fmax  %t0, %col0, %col1
        fmax  %t1, %col2, %col3
        fmax  %t2, %col4, %col5
        fmax  %t3, %col6, %col7
        fmax  %t4, %t0, %t1
        fmax  %t5, %t2, %t3
        fmax  %t4, %t4, %t5
        fmax  %new_max, %new_max, %t4
        uaddi %walk, %walk, 8
        usetp.lt.u32 p2, %walk, %s_end
@p2     bra.uni ROW_MAX

; Positive scale lets max commute with score scaling. Maxima use base-2 units.
        fmul  %new_max, %new_max, %scale
        fmax  %new_max, %new_max, %max
        fsub  %alpha, %max, %new_max
        ex2   %alpha, %alpha      ; alpha = 2^(old_max - new_max)
        addi  %max, %new_max, 0
        mov   %block_sum, 0
        umov  %walk, %s_rows
        addi  %chunk, %p_row, 0   ; chunk zero of this row, unshuffled

; Pass 2: exp(score - max), FP32 row sum, packed-half P in the swizzle64
; layout the MMA reads (one 16-byte piece per chunk of eight columns).
MAKE_P:
        acc.ld.v8 %col0, [%walk, S.row_words]
        addi  %scale_a, %scale, 0
        addi  %scale_b, %scale, 0
        fmul  %col0, %col0, %scale_a
        fmul  %col1, %col1, %scale_a
        fmul  %col2, %col2, %scale_b
        fmul  %col3, %col3, %scale_a
        fmul  %col4, %col4, %scale_a
        fmul  %col5, %col5, %scale_b
        fmul  %col6, %col6, %scale_a
        fmul  %col7, %col7, %scale_a
        addi  %max_a, %new_max, 0
        addi  %max_b, %new_max, 0
        fsub  %col0, %col0, %max_a
        fsub  %col1, %col1, %max_a
        fsub  %col2, %col2, %max_b
        fsub  %col3, %col3, %max_a
        fsub  %col4, %col4, %max_a
        fsub  %col5, %col5, %max_b
        fsub  %col6, %col6, %max_a
        fsub  %col7, %col7, %max_a
        ex2   %col0, %col0
        ex2   %col1, %col1
        ex2   %col2, %col2
        ex2   %col3, %col3
        ex2   %col4, %col4
        ex2   %col5, %col5
        ex2   %col6, %col6
        ex2   %col7, %col7
        fadd  %sum0, %col0, %col1
        fadd  %sum1, %col2, %col3
        fadd  %sum2, %col4, %col5
        fadd  %sum3, %col6, %col7
        fadd  %sum4, %sum0, %sum1
        fadd  %sum5, %sum2, %sum3
        fadd  %sum4, %sum4, %sum5
        fadd  %block_sum, %block_sum, %sum4
        xor   %pa0, %chunk, %shuffle ; the chunk's word 0 (its four words: %pa0 XOR 0, 4, 8, 12)
        cvt.pack.f16x2 %pk, %col0, %col1
        sts   [%pa0], %pk
        xori  %pa, %pa0, 4
        cvt.pack.f16x2 %pk, %col2, %col3
        sts   [%pa], %pk
        xori  %pa, %pa0, 8
        cvt.pack.f16x2 %pk, %col4, %col5
        sts   [%pa], %pk
        xori  %pa, %pa0, 12
        cvt.pack.f16x2 %pk, %col6, %col7
        sts   [%pa], %pk
        addi  %chunk, %chunk, 16
        uaddi %walk, %walk, 8
        usetp.lt.u32 p2, %walk, %s_end
@p2     bra.uni MAKE_P

        fmul  %denom, %denom, %alpha
        fadd  %denom, %denom, %block_sum
        sts   [%stats], %max      ; per-block diagnostic row max
        sts   [%stats + STAT_FIELD], %denom ; denominator before final normalization
        sts   [%stats + 2 * STAT_FIELD], %alpha ; alpha (zero for first block)
        addi  %stats, %stats, STATS.stride
        usetp.eq.u32 p2, %block, 0
@p2     bra.uni P_READY           ; first PV uses init; never read uninitialized O

; Correct the old FP32 numerator BEFORE accumulating this block's PV.
        umov  %walk, %o_rows
        addi  %alpha_a, %alpha, 0
        addi  %alpha_b, %alpha, 0
CORRECT_O:
        acc.ld.v8 %col0, [%walk, O.row_words]
        fmul  %col0, %col0, %alpha_a
        fmul  %col1, %col1, %alpha_a
        fmul  %col2, %col2, %alpha_b
        fmul  %col3, %col3, %alpha_a
        fmul  %col4, %col4, %alpha_a
        fmul  %col5, %col5, %alpha_b
        fmul  %col6, %col6, %alpha_a
        fmul  %col7, %col7, %alpha_a
        acc.st.v8 [%walk, O.row_words], %col0
        uaddi %walk, %walk, 8
        usetp.lt.u32 p2, %walk, %o_end
@p2     bra.uni CORRECT_O

P_READY:
        mbar.arrive [%work_bar]   ; qtxc waits for this warp's sts + acc.st depbar
PV_READY:
        mbar.try_wait p1, [%output_bar], %block
@!p1    bra.uni PV_READY
        uaddi %block, %block, 1
        usetp.lt.u32 p2, %block, 2
@p2     bra.uni WORK_BLOCK

; Final normalization, one row per lane, staged in shmem as an fp32
; swizzle64 tile (256-byte rows) for one TMA store per worker pair:
;   addr(row, col) = OSTAGE + OSTAGE.row_bytes*row + ((4*col) XOR %shuffle)
; A chunk of eight columns is 32 unshuffled bytes at %out_chunk (OSTAGE + OSTAGE.row_bytes*row +
; 32*chunk); its column j is at (%out_chunk XOR %shuffle) XOR 4j. A column sts over 16 rows
; takes one bank round. Columns c+2 and c+3 are scaled into registers of
; their own (%n2, %n3).
        rcp   %inv, %denom
        addi  %inv_a, %inv, 0
        addi  %inv_b, %inv, 0
        umov  %walk, %o_rows
        shli  %out_chunk, %row, log2(OSTAGE.row_bytes)
        addi  %out_chunk, %out_chunk, OSTAGE ; chunk zero of this row, unshuffled
NORMALIZE:
        acc.ld.v8 %col0, [%walk, O.row_words]
        fmul  %col0, %col0, %inv_a
        fmul  %col1, %col1, %inv_a
        fmul  %n2, %col2, %inv_b
        fmul  %n3, %col3, %inv_a
        fmul  %col4, %col4, %inv_a
        fmul  %col5, %col5, %inv_b
        fmul  %col6, %col6, %inv_a
        fmul  %col7, %col7, %inv_a
        xor   %oa, %out_chunk, %shuffle ; col c
        sts   [%oa], %col0
        xori  %ob, %oa, 4         ; col c+1
        sts   [%ob], %col1
        xori  %oc, %oa, 8         ; col c+2
        sts   [%oc], %n2
        xori  %od, %oa, 12        ; col c+3
        sts   [%od], %n3
        xori  %ob, %oa, 16        ; col c+4 (the next 16-byte piece)
        sts   [%ob], %col4
        xori  %oc, %oa, 20        ; col c+5
        sts   [%oc], %col5
        xori  %od, %oa, 24        ; col c+6
        sts   [%od], %col6
        xori  %ob, %oa, 28        ; col c+7
        sts   [%ob], %col7
        addi  %out_chunk, %out_chunk, 32
        uaddi %walk, %walk, 8
        usetp.lt.u32 p2, %walk, %o_end
@p2     bra.uni NORMALIZE

        mbar.arrive [%staged_bar] ; qtxc waits for this warp's sts depbar
        halt

; ---- issuer: one K/V stage per key block, shared by both query tiles ----
ISSUER:
        umov  %input_done, INPUT_DONE
        umov  %coord0, 0          ; TMA coordinates (channel, row)
        umov  %coord1, 0
        umov  %qbuf, QBUF[0]
        umov  %kbuf, KBUF[0]      ; current K and V for both query tiles
        umov  %vbuf, VBUF[0]
        mbar.arrive.expect_tx [%input_done], QBUF.bytes + KBUF[0].bytes + VBUF[0].bytes
        tma.load.2d [%qbuf], [QDESC, %coord0], [%input_done]
        umov  %qbuf, QBUF[1]
        umov  %coord1, 32
        tma.load.2d [%qbuf], [QDESC, %coord0], [%input_done]
        umov  %coord1, 0
        tma.load.2d [%kbuf], [KDESC, %coord0], [%input_done]
        tma.load.2d [%vbuf], [VDESC, %coord0], [%input_done]

        umov  %score0, SCORE
        umov  %score1, SCORE[1]
        umov  %work0, WORK
        umov  %work1, WORK[1]
        umov  %output0, OUTPUT
        umov  %output1, OUTPUT[1]
        umov  %block, 0           ; key block, also the workers' barrier parity
        umov  %kbuf_next, KBUF[1]
        umov  %vbuf_next, VBUF[1]
        umov  %acc_s0, S[0]       ; the four 32x64 results: S0, S1, O0, O1
        umov  %acc_s1, S[1]
        umov  %acc_o0, O[0]
        umov  %acc_o1, O[1]
IN0:
        mbar.try_wait p1, [%input_done], 0
@!p1    bra.uni IN0
; Prefetch the second K/V stage while MMA and the workers use the first.
        umov  %coord1, 64
        mbar.arrive.expect_tx [%input_done], KBUF[1].bytes + VBUF[1].bytes
        tma.load.2d [%kbuf_next], [KDESC, %coord0], [%input_done]
        tma.load.2d [%vbuf_next], [VDESC, %coord0], [%input_done]

KEY_BLOCK:
        usetp.eq.u32 p2, %block, 0
; Each command consumes eight fp16 values per row. The next K slice is
; 16 bytes farther along each 128-byte row. Commit S0 as soon as it is ready:
; warps 1/2 can run softmax while the tensor core computes S1.
        umov  %a_op, QBUF[0]
        umov  %b_op, %kbuf
        mma.async.init.m32n64k8 [%acc_s0], [%a_op, QBUF.row_bytes], [%b_op, KBUF.row_bytes]
        uaddi %a_op, %a_op, 16
        uaddi %b_op, %b_op, 16
        mma.async.m32n64k8 [%acc_s0], [%a_op, QBUF.row_bytes], [%b_op, KBUF.row_bytes]
        uaddi %a_op, %a_op, 16
        uaddi %b_op, %b_op, 16
        mma.async.m32n64k8 [%acc_s0], [%a_op, QBUF.row_bytes], [%b_op, KBUF.row_bytes]
        uaddi %a_op, %a_op, 16
        uaddi %b_op, %b_op, 16
        mma.async.m32n64k8 [%acc_s0], [%a_op, QBUF.row_bytes], [%b_op, KBUF.row_bytes]
        uaddi %a_op, %a_op, 16
        uaddi %b_op, %b_op, 16
        mma.async.m32n64k8 [%acc_s0], [%a_op, QBUF.row_bytes], [%b_op, KBUF.row_bytes]
        uaddi %a_op, %a_op, 16
        uaddi %b_op, %b_op, 16
        mma.async.m32n64k8 [%acc_s0], [%a_op, QBUF.row_bytes], [%b_op, KBUF.row_bytes]
        uaddi %a_op, %a_op, 16
        uaddi %b_op, %b_op, 16
        mma.async.m32n64k8 [%acc_s0], [%a_op, QBUF.row_bytes], [%b_op, KBUF.row_bytes]
        uaddi %a_op, %a_op, 16
        uaddi %b_op, %b_op, 16
        mma.async.m32n64k8 [%acc_s0], [%a_op, QBUF.row_bytes], [%b_op, KBUF.row_bytes]
        mma.commit [%score0]

        umov  %a_op, QBUF[1]
        umov  %b_op, %kbuf
        mma.async.init.m32n64k8 [%acc_s1], [%a_op, QBUF.row_bytes], [%b_op, KBUF.row_bytes]
        uaddi %a_op, %a_op, 16
        uaddi %b_op, %b_op, 16
        mma.async.m32n64k8 [%acc_s1], [%a_op, QBUF.row_bytes], [%b_op, KBUF.row_bytes]
        uaddi %a_op, %a_op, 16
        uaddi %b_op, %b_op, 16
        mma.async.m32n64k8 [%acc_s1], [%a_op, QBUF.row_bytes], [%b_op, KBUF.row_bytes]
        uaddi %a_op, %a_op, 16
        uaddi %b_op, %b_op, 16
        mma.async.m32n64k8 [%acc_s1], [%a_op, QBUF.row_bytes], [%b_op, KBUF.row_bytes]
        uaddi %a_op, %a_op, 16
        uaddi %b_op, %b_op, 16
        mma.async.m32n64k8 [%acc_s1], [%a_op, QBUF.row_bytes], [%b_op, KBUF.row_bytes]
        uaddi %a_op, %a_op, 16
        uaddi %b_op, %b_op, 16
        mma.async.m32n64k8 [%acc_s1], [%a_op, QBUF.row_bytes], [%b_op, KBUF.row_bytes]
        uaddi %a_op, %a_op, 16
        uaddi %b_op, %b_op, 16
        mma.async.m32n64k8 [%acc_s1], [%a_op, QBUF.row_bytes], [%b_op, KBUF.row_bytes]
        uaddi %a_op, %a_op, 16
        uaddi %b_op, %b_op, 16
        mma.async.m32n64k8 [%acc_s1], [%a_op, QBUF.row_bytes], [%b_op, KBUF.row_bytes]
        mma.commit [%score1]

; Each pair publishes its P and corrected O independently. Block 0 initializes
; the numerator. Block 1 adds to the FP32 numerator scaled by that pair.
P0_READY:
        mbar.try_wait p1, [%work0], %block
@!p1    bra.uni P0_READY
        umov  %a_op, PBUF[0]
        umov  %b_op, %vbuf
@!p2    bra.uni ADD_O0
        mma.async.init.m32n64k8 [%acc_o0], [%a_op, PBUF.row_bytes], [%b_op, VBUF.row_bytes]
        bra   MORE_O0
ADD_O0: mma.async.m32n64k8 [%acc_o0], [%a_op, PBUF.row_bytes], [%b_op, VBUF.row_bytes]
MORE_O0:
        uaddi %a_op, %a_op, 16
        uaddi %b_op, %b_op, 16
        mma.async.m32n64k8 [%acc_o0], [%a_op, PBUF.row_bytes], [%b_op, VBUF.row_bytes]
        uaddi %a_op, %a_op, 16
        uaddi %b_op, %b_op, 16
        mma.async.m32n64k8 [%acc_o0], [%a_op, PBUF.row_bytes], [%b_op, VBUF.row_bytes]
        uaddi %a_op, %a_op, 16
        uaddi %b_op, %b_op, 16
        mma.async.m32n64k8 [%acc_o0], [%a_op, PBUF.row_bytes], [%b_op, VBUF.row_bytes]
        uaddi %a_op, %a_op, 16
        uaddi %b_op, %b_op, 16
        mma.async.m32n64k8 [%acc_o0], [%a_op, PBUF.row_bytes], [%b_op, VBUF.row_bytes]
        uaddi %a_op, %a_op, 16
        uaddi %b_op, %b_op, 16
        mma.async.m32n64k8 [%acc_o0], [%a_op, PBUF.row_bytes], [%b_op, VBUF.row_bytes]
        uaddi %a_op, %a_op, 16
        uaddi %b_op, %b_op, 16
        mma.async.m32n64k8 [%acc_o0], [%a_op, PBUF.row_bytes], [%b_op, VBUF.row_bytes]
        uaddi %a_op, %a_op, 16
        uaddi %b_op, %b_op, 16
        mma.async.m32n64k8 [%acc_o0], [%a_op, PBUF.row_bytes], [%b_op, VBUF.row_bytes]
        mma.commit [%output0]

P1_READY:
        mbar.try_wait p1, [%work1], %block
@!p1    bra.uni P1_READY
        umov  %a_op, PBUF[1]
        umov  %b_op, %vbuf
@!p2    bra.uni ADD_O1
        mma.async.init.m32n64k8 [%acc_o1], [%a_op, PBUF.row_bytes], [%b_op, VBUF.row_bytes]
        bra   MORE_O1
ADD_O1: mma.async.m32n64k8 [%acc_o1], [%a_op, PBUF.row_bytes], [%b_op, VBUF.row_bytes]
MORE_O1:
        uaddi %a_op, %a_op, 16
        uaddi %b_op, %b_op, 16
        mma.async.m32n64k8 [%acc_o1], [%a_op, PBUF.row_bytes], [%b_op, VBUF.row_bytes]
        uaddi %a_op, %a_op, 16
        uaddi %b_op, %b_op, 16
        mma.async.m32n64k8 [%acc_o1], [%a_op, PBUF.row_bytes], [%b_op, VBUF.row_bytes]
        uaddi %a_op, %a_op, 16
        uaddi %b_op, %b_op, 16
        mma.async.m32n64k8 [%acc_o1], [%a_op, PBUF.row_bytes], [%b_op, VBUF.row_bytes]
        uaddi %a_op, %a_op, 16
        uaddi %b_op, %b_op, 16
        mma.async.m32n64k8 [%acc_o1], [%a_op, PBUF.row_bytes], [%b_op, VBUF.row_bytes]
        uaddi %a_op, %a_op, 16
        uaddi %b_op, %b_op, 16
        mma.async.m32n64k8 [%acc_o1], [%a_op, PBUF.row_bytes], [%b_op, VBUF.row_bytes]
        uaddi %a_op, %a_op, 16
        uaddi %b_op, %b_op, 16
        mma.async.m32n64k8 [%acc_o1], [%a_op, PBUF.row_bytes], [%b_op, VBUF.row_bytes]
        uaddi %a_op, %a_op, 16
        uaddi %b_op, %b_op, 16
        mma.async.m32n64k8 [%acc_o1], [%a_op, PBUF.row_bytes], [%b_op, VBUF.row_bytes]
        mma.commit [%output1]

@!p2    bra.uni WRITE_OUTPUT
        umov  %block, 1
        umov  %kbuf, %kbuf_next
        umov  %vbuf, %vbuf_next
IN1:
        mbar.try_wait p1, [%input_done], 1
@!p1    bra.uni IN1
        bra   KEY_BLOCK

; Each pair stages 32 fp32 rows. Start draining the first tile while the
; second pair can still be normalizing. Both stores credit the same 16 KiB.
WRITE_OUTPUT:
        umov  %staged0, STAGED
        umov  %staged1, STAGED[1]
        umov  %stored, OSTORE_DONE
        umov  %ostage0, OSTAGE[0]
        umov  %ostage1, OSTAGE[1]
        umov  %coord1, 0
        mbar.arrive.expect_tx [%stored], OSTAGE.bytes
WAIT_STAGE0:
        mbar.try_wait p1, [%staged0], 0
@!p1    bra.uni WAIT_STAGE0
        tma.store.2d [ODESC, %coord0], [%ostage0], [%stored]
        umov  %coord1, 32
WAIT_STAGE1:
        mbar.try_wait p1, [%staged1], 0
@!p1    bra.uni WAIT_STAGE1
        tma.store.2d [ODESC, %coord0], [%ostage1], [%stored]
STORED:
        mbar.try_wait p1, [%stored], 0
@!p1    bra.uni STORED
        halt
