; First executable FlashAttention: Q[64,64], K/V[128,64], two key blocks.
; Warp 0: TMA + MMA issuer. Warps 1..4: sixteen complete rows each.
; Unmasked/full tiles, fp16 Q/K/V/P, fp32 S/O/statistics. K/V prefetch overlaps MMA.
; See fa.launch.py for descriptors, constants, independent reference and census.
;
; Worker registers:
; r1 row, r2 staged-output barrier, r3 stats pointer, r4/r5 P addresses,
; r6 block/parity, r8 constants, r9 log2(e)/8, r10 running max, r11 denominator,
; r12 new max, r13 alpha/inverse, r14 block sum, r15 scratch, r16..23 eight-column
; chunk, r24..29 reduction/coefficient/packing scratch, r30/r31 O staging
; addresses (even/odd columns), r32/r33 TMEM row/column, r34 score-ready,
; r35 workers-done, r37 PV-done (OUTPUT_DONE, the PV commit barrier).

.acc S, 0, 0, 64, 64
.acc O, 1, 0, 64, 64
; Double-buffered K/V stage sets (roofline E3): TMA fills set 1 on port A
; while MMA reads set 0 on port B — the two async engines finally overlap.
.equ QBUF,       0
.equ KBUF0,      8192
.equ VBUF0,      16384
.equ KBUF1,      24576
.equ VBUF1,      32768
.equ PBUF,       40960
; Output staging reuses Q + K stage 0 (bytes 0..16383): sixteen 1024-byte
; fp32 xor64_a objects. Workers write it only after waiting block 1's PV
; commit (OUTPUT_DONE parity 1); a commit arrives only once every earlier MMA
; command has retired, so no MMA read of Q (last: QK1) or K0 (last: QK0) is
; outstanding, and the only TMA loads into them (prologue) completed long ago.
; This ordering argument is what makes the reuse safe, and the shmem ownership
; sanitizer now checks it: an sts into a range a queued/active MMA or the TMA
; store still owns panics (trash/shmem-ownership-sanitizer-2026-10-03.md).
.equ OSTAGE,     0
.equ SCORE_DONE, 49160
.equ OUTPUT_DONE,49168
.equ WORK_DONE,  49176
.equ INPUT_DONE, 49184
.equ OSTAGE_DONE,49192
.equ OSTORE_DONE,49200
.equ CONSTANTS,  49216
.equ QDESC,      49664
.equ KDESC0,     49728
.equ VDESC0,     49792
.equ KDESC1,     49856
.equ VDESC1,     49920
.equ ODESC,      49984
.equ STATS,      50176

        sread r0, WARP_ID
        setp.eq p0, r0, 0
@p0     bra.uni ISSUER

; ---- row workers ----
        sread r32, WARP_ID
        addi  r32, r32, -1
        shli  r32, r32, 4
        sread r0, LANE_ID
        add   r1, r0, r32
        shli  r3, r1, 2
        addi  r3, r3, STATS
        mov   r8, CONSTANTS
        lds.uni r9, [r8]
        lds.uni r10, [r8+4]        ; -infinity
        mov   r11, 0              ; denominator = 0.0
        mov   r6, 0
        mov   r34, SCORE_DONE
        mov   r35, WORK_DONE
        mov   r37, OUTPUT_DONE
; P pair-zero base for this row, computed in-kernel: PBUF + 16*row + 4*((row>>2)&1).
        shli  r36, r1, 4
        shri  r26, r1, 2
        andi  r26, r26, 1
        shli  r26, r26, 2
        add   r36, r36, r26
        addi  r36, r36, PBUF

WORK_BLOCK:
S_READY:
        mbar.try_wait p1, [r34], r6
@!p1    bra.uni S_READY

; Pass 1: row max. Keep only eight scores resident, not a whole row.
        lds.uni r12, [r8+4]
        mov   r33, 0
ROW_MAX:
        acc.ld.v8 r16, S, r32
        fmax  r24, r16, r17
        fmax  r25, r18, r19
        fmax  r26, r20, r21
        fmax  r27, r22, r23
        fmax  r28, r24, r25
        fmax  r29, r26, r27
        fmax  r28, r28, r29
        fmax  r12, r12, r28
        addi  r33, r33, 8
        setp.lt p2, r33, 64
@p2     bra.uni ROW_MAX

; Positive scale lets max commute with score scaling. Maxima use base-2 units.
        addi  r25, r9, 0
        fmul  r12, r12, r25
        fmax  r12, r12, r10
        fsub  r13, r10, r12
        ex2   r13, r13             ; alpha = 2^(old_max - new_max)
        addi  r10, r12, 0
        mov   r14, 0
        mov   r33, 0
        addi  r4, r36, 0           ; pair-zero address for this row, chunk zero

; Pass 2: exp(score - max), FP32 row sum, packed-half P in MMA's A layout.
MAKE_P:
        acc.ld.v8 r16, S, r32
        addi  r24, r9, 0
        addi  r25, r9, 0
        fmul  r16, r16, r24
        fmul  r17, r17, r24
        fmul  r18, r18, r25
        fmul  r19, r19, r24
        fmul  r20, r20, r24
        fmul  r21, r21, r25
        fmul  r22, r22, r24
        fmul  r23, r23, r24
        addi  r24, r12, 0
        addi  r25, r12, 0
        fsub  r16, r16, r24
        fsub  r17, r17, r24
        fsub  r18, r18, r25
        fsub  r19, r19, r24
        fsub  r20, r20, r24
        fsub  r21, r21, r25
        fsub  r22, r22, r24
        fsub  r23, r23, r24
        ex2   r16, r16
        ex2   r17, r17
        ex2   r18, r18
        ex2   r19, r19
        ex2   r20, r20
        ex2   r21, r21
        ex2   r22, r22
        ex2   r23, r23
        fadd  r24, r16, r17
        fadd  r25, r18, r19
        fadd  r26, r20, r21
        fadd  r27, r22, r23
        fadd  r28, r24, r25
        fadd  r29, r26, r27
        fadd  r28, r28, r29
        fadd  r14, r14, r28
        cvt.pack.f16x2 r27, r16, r17
        sts   [r4], r27
        xori  r5, r4, 4
        cvt.pack.f16x2 r27, r18, r19
        sts   [r5], r27
        xori  r5, r4, 8
        cvt.pack.f16x2 r27, r20, r21
        sts   [r5], r27
        xori  r5, r4, 12
        cvt.pack.f16x2 r27, r22, r23
        sts   [r5], r27
        addi  r4, r4, 1024
        addi  r33, r33, 8
        setp.lt p2, r33, 64
@p2     bra.uni MAKE_P

        fmul  r11, r11, r13
        addi  r15, r14, 0
        fadd  r11, r11, r15
        sts   [r3], r10           ; per-block diagnostic row max
        sts   [r3+256], r11       ; denominator before final normalization
        sts   [r3+512], r13       ; alpha (zero for first block)
        addi  r3, r3, 1024
        setp.eq p2, r6, 0
@p2     bra.uni P_READY           ; first PV uses init; never read uninitialized O

; Correct the old FP32 numerator BEFORE accumulating this block's PV.
        mov   r33, 0
        addi  r24, r13, 0
        addi  r25, r13, 0
CORRECT_O:
        acc.ld.v8 r16, O, r32
        fmul  r16, r16, r24
        fmul  r17, r17, r24
        fmul  r18, r18, r25
        fmul  r19, r19, r24
        fmul  r20, r20, r24
        fmul  r21, r21, r25
        fmul  r22, r22, r24
        fmul  r23, r23, r24
        acc.st.v8 O, r32, r16
        addi  r33, r33, 8
        setp.lt p2, r33, 64
@p2     bra.uni CORRECT_O

P_READY:
        mbar.arrive [r35]         ; qtxc waits for this warp's sts + acc.st depbar
PV_READY:
        mbar.try_wait p1, [r37], r6
@!p1    bra.uni PV_READY
        addi  r6, r6, 1
        setp.lt p2, r6, 2
@p2     bra.uni WORK_BLOCK

; Final normalization, one row per lane, staged in shmem in the fp32 xor64_a
; layout (the same byte permutation as the operand tiles, four floats per
; 16-byte row) for one TMA store of the whole tile:
;   addr(row, col) = OSTAGE + 1024*(col>>2) + 16*row + 4*((col&3) ^ ((row>>2)&1))
; With x = 4*((row>>2)&1): even columns sit at OSTAGE + 16*row + x (r30) and
; odd columns at that address XOR 4 (r31), plus 8*((col>>1)&1) + 1024*(col>>2).
; A column sts over 16 rows takes two bank rounds (rows r and r+8 share a bank).
; RF banks (reg mod 3): r30 is bank 0 and r31 bank 1; columns c+2 and c+3 are
; scaled into r26 (bank 2) and r27 (bank 0) so no sts names two same-bank regs.
        rcp   r13, r11
        addi  r24, r13, 0
        addi  r25, r13, 0
        mov   r33, 0
        shli  r30, r1, 4
        shri  r26, r1, 2
        andi  r26, r26, 1
        shli  r26, r26, 2
        add   r30, r30, r26
        addi  r30, r30, OSTAGE    ; even-column base for chunk 0
        xori  r31, r30, 4         ; odd-column base for chunk 0
        mov   r2, OSTAGE_DONE
NORMALIZE:
        acc.ld.v8 r16, O, r32
        fmul  r16, r16, r24
        fmul  r17, r17, r24
        fmul  r26, r18, r25
        fmul  r27, r19, r24
        fmul  r20, r20, r24
        fmul  r21, r21, r25
        fmul  r22, r22, r24
        fmul  r23, r23, r24
        sts   [r30], r16          ; col c
        sts   [r31], r17          ; col c+1
        sts   [r30+8], r26        ; col c+2
        sts   [r31+8], r27        ; col c+3
        sts   [r30+1024], r20     ; col c+4 (next object)
        sts   [r31+1024], r21     ; col c+5
        sts   [r30+1032], r22     ; col c+6
        sts   [r31+1032], r23     ; col c+7
        addi  r30, r30, 2048
        addi  r31, r31, 2048
        addi  r33, r33, 8
        setp.lt p2, r33, 64
@p2     bra.uni NORMALIZE

        mbar.arrive [r2]          ; qtxc waits for this warp's sts depbar
        halt

; ---- issuer: two unrolled blocks; block 1's inputs prefetch under block 0 ----
ISSUER:
        mov   r2, INPUT_DONE
        mov   r3, SCORE_DONE
        mov   r4, WORK_DONE
        mov   r5, OUTPUT_DONE
        mov   r8, 0
        mov   r9, 0
        mov   r10, 0
; Prologue: Q and block 0's K/V land together — one barrier round trip.
        mbar.arrive.expect_tx [r2], 24576
        tma.async [QDESC], r8
        tma.async [KDESC0], r8
        tma.async [VDESC0], r8
IN0:
        mbar.try_wait p1, [r2], 0
@!p1    bra.uni IN0
; Prefetch block 1 into stage set 1: port A fills while MMA reads set 0.
        mov   r9, 64
        mbar.arrive.expect_tx [r2], 16384
        tma.async [KDESC1], r8
        tma.async [VDESC1], r8
        mov   r9, 0

        mov   r0, QBUF
        mov   r1, KBUF0
        mma.async.init S, [r0], [r1]
        addi r0, r0, 1024
        addi r1, r1, 1024
        mma.async S, [r0], [r1]
        addi r0, r0, 1024
        addi r1, r1, 1024
        mma.async S, [r0], [r1]
        addi r0, r0, 1024
        addi r1, r1, 1024
        mma.async S, [r0], [r1]
        addi r0, r0, 1024
        addi r1, r1, 1024
        mma.async S, [r0], [r1]
        addi r0, r0, 1024
        addi r1, r1, 1024
        mma.async S, [r0], [r1]
        addi r0, r0, 1024
        addi r1, r1, 1024
        mma.async S, [r0], [r1]
        addi r0, r0, 1024
        addi r1, r1, 1024
        mma.async S, [r0], [r1]
        mma.commit [r3]
W0:
        mbar.try_wait p1, [r4], 0
@!p1    bra.uni W0

        mov   r0, PBUF
        mov   r1, VBUF0
        mma.async.init O, [r0], [r1]
        addi r0, r0, 1024
        addi r1, r1, 1024
        mma.async O, [r0], [r1]
        addi r0, r0, 1024
        addi r1, r1, 1024
        mma.async O, [r0], [r1]
        addi r0, r0, 1024
        addi r1, r1, 1024
        mma.async O, [r0], [r1]
        addi r0, r0, 1024
        addi r1, r1, 1024
        mma.async O, [r0], [r1]
        addi r0, r0, 1024
        addi r1, r1, 1024
        mma.async O, [r0], [r1]
        addi r0, r0, 1024
        addi r1, r1, 1024
        mma.async O, [r0], [r1]
        addi r0, r0, 1024
        addi r1, r1, 1024
        mma.async O, [r0], [r1]
        mma.commit [r5]
; Block 1: data long since prefetched; QK(1) queues behind PV(0)'s commit
; fence and the engine flows through with no issuer round trip.
IN1:
        mbar.try_wait p1, [r2], 1
@!p1    bra.uni IN1
        mov   r0, QBUF
        mov   r1, KBUF1
        mma.async.init S, [r0], [r1]
        addi r0, r0, 1024
        addi r1, r1, 1024
        mma.async S, [r0], [r1]
        addi r0, r0, 1024
        addi r1, r1, 1024
        mma.async S, [r0], [r1]
        addi r0, r0, 1024
        addi r1, r1, 1024
        mma.async S, [r0], [r1]
        addi r0, r0, 1024
        addi r1, r1, 1024
        mma.async S, [r0], [r1]
        addi r0, r0, 1024
        addi r1, r1, 1024
        mma.async S, [r0], [r1]
        addi r0, r0, 1024
        addi r1, r1, 1024
        mma.async S, [r0], [r1]
        addi r0, r0, 1024
        addi r1, r1, 1024
        mma.async S, [r0], [r1]
        mma.commit [r3]
W1:
        mbar.try_wait p1, [r4], 1
@!p1    bra.uni W1
        mov   r0, PBUF
        mov   r1, VBUF1
        mma.async O, [r0], [r1]
        addi r0, r0, 1024
        addi r1, r1, 1024
        mma.async O, [r0], [r1]
        addi r0, r0, 1024
        addi r1, r1, 1024
        mma.async O, [r0], [r1]
        addi r0, r0, 1024
        addi r1, r1, 1024
        mma.async O, [r0], [r1]
        addi r0, r0, 1024
        addi r1, r1, 1024
        mma.async O, [r0], [r1]
        addi r0, r0, 1024
        addi r1, r1, 1024
        mma.async O, [r0], [r1]
        addi r0, r0, 1024
        addi r1, r1, 1024
        mma.async O, [r0], [r1]
        addi r0, r0, 1024
        addi r1, r1, 1024
        mma.async O, [r0], [r1]
        mma.commit [r5]
; Epilogue: the four workers stage normalized O (16 KiB) into OSTAGE; one TMA
; store writes it to gmem. The store's mbar certifies that the shmem source
; was consumed; the kernel-end drain retires the gmem writes.
        mov   r6, OSTAGE_DONE
STAGED:
        mbar.try_wait p1, [r6], 0
@!p1    bra.uni STAGED
        mov   r7, OSTORE_DONE
        mbar.arrive.expect_tx [r7], 16384
        tma.async [ODESC], r8
STORED:
        mbar.try_wait p1, [r7], 0
@!p1    bra.uni STORED
        halt
