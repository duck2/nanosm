; First executable FlashAttention: Q[64,64], K/V[128,64], two key blocks.
; Warp 0: TMA + MMA issuer. Warps 1..4: sixteen complete rows each.
; Unmasked/full tiles, fp16 Q/K/V/P, fp32 S/O/statistics. K/V prefetch overlaps MMA.
; See fa.launch.py for descriptors, constants, independent reference and census.
;
; Worker registers:
; r0 the unshuffled address of the current 16- or 32-byte chunk (P, then the
; staged O), r1 row, r2 column loop counter (the loop's setp), r3 stats
; pointer, r4/r5 P addresses, r6 block (the loop's setp), r7 the row's P
; base, r8 the row's shuffle constant, r9 log2(e)/8, r10 running max, r11
; denominator, r12 new max, r13 alpha/inverse, r14 block sum, r15 scratch,
; r16..23 eight-column chunk, r24..29 reduction/coefficient/packing
; scratch, r30/r31/r4/r5 O staging addresses.
;
; P and the staged O are swizzle64 tiles (src/layout.hpp): row r whole at
; base + r x spacing (128 bytes for P, 256 for O), and inside the row byte b
; at b XOR the row's constant ((r & 3) << 4 | (r & 12)): the 16-byte piece's
; slot XOR r & 3, the word's XOR (r / 4) & 3. One constant per row serves
; both tiles (rows of 64 bytes or more). The rule takes the row number from
; the address (base / spacing + r); counting r from the tile agrees because
; PBUF and OSTAGE are multiples of 16 rows (2048 and 4096 bytes).
; Worker uniform registers: ur0/ur1 TMEM row/column (the acc coordinate
; pair), ur2 constants, ur3 score-ready, ur4 workers-done, ur5 PV-done
; (OUTPUT_DONE, the PV commit barrier), ur6 block parity, ur7 staged-output
; barrier.

.acc S, 0, 64, 64
.acc O, 4096, 64, 64
; Double-buffered K/V stage sets (roofline E3): TMA fills set 1 on port A
; while MMA reads set 0 on port B — the two async engines finally overlap.
.equ QBUF,       0
.equ KBUF0,      8192
.equ VBUF0,      16384
.equ KBUF1,      24576
.equ VBUF1,      32768
.equ PBUF,       40960
; Output staging reuses Q + K stage 0 (bytes 0..16383): 64 fp32 swizzle64
; rows of 256 bytes. Workers write it only after waiting block 1's PV
; commit (OUTPUT_DONE parity 1); a commit arrives only once every earlier MMA
; command has retired, so no MMA read of Q (last: QK1) or K0 (last: QK0) is
; outstanding, and the only TMA loads into them (prologue) completed long ago.
; This ordering argument is what makes the reuse safe, and the shmem ownership
; sanitizer now checks it: an sts into a range a queued/active MMA or the TMA
; store still owns panics (trash/shmem-ownership-sanitizer-2026-10-03.md).
.equ OSTAGE,     0
.equ SCORE_DONE, 49160
.equ OUTPUT_DONE,49168
.equ WORK_DONE,  49176
.equ INPUT_DONE, 49184
.equ OSTAGE_DONE,49192
.equ OSTORE_DONE,49200
.equ CONSTANTS,  49216
.equ QDESC,      49664
.equ KDESC,      49728
.equ VDESC,      49792
.equ ODESC,      49984
.equ STATS,      50176

        usread ur0, WARP_ID
        ur2r  r0, ur0
        setp.eq p0, r0, 0
@p0     bra.uni ISSUER

; ---- row workers ----
        uaddi ur0, ur0, -1
        ushli ur0, ur0, 4          ; TMEM row base: 16 * (warp - 1)
        sread r0, LANE_ID
        ur2r  r1, ur0
        add   r1, r0, r1           ; row
        shli  r3, r1, 2
        addi  r3, r3, STATS
        umov  ur2, CONSTANTS
        lds.uni r9, [ur2]
        lds.uni r10, [ur2+4]       ; -infinity
        mov   r11, 0              ; denominator = 0.0
        mov   r6, 0
        umov  ur6, 0
        umov  ur3, SCORE_DONE
        umov  ur4, WORK_DONE
        umov  ur5, OUTPUT_DONE
; This row's P base, PBUF + 128*row, and its shuffle constant (r & 3) << 4 | (r & 12).
        shli  r7, r1, 7
        addi  r7, r7, PBUF
        andi  r8, r1, 3
        shli  r8, r8, 4
        andi  r27, r1, 12
        or    r8, r8, r27

WORK_BLOCK:
S_READY:
        mbar.try_wait p1, [ur3], ur6
@!p1    bra.uni S_READY

; Pass 1: row max. Keep only eight scores resident, not a whole row.
        lds.uni r12, [ur2+4]
        umov  ur1, 0
        mov   r2, 0
ROW_MAX:
        acc.ld.v8 r16, S, ur0
        fmax  r24, r16, r17
        fmax  r25, r18, r19
        fmax  r26, r20, r21
        fmax  r27, r22, r23
        fmax  r28, r24, r25
        fmax  r29, r26, r27
        fmax  r28, r28, r29
        fmax  r12, r12, r28
        uaddi ur1, ur1, 8
        addi  r2, r2, 8
        setp.lt p2, r2, 64
@p2     bra.uni ROW_MAX

; Positive scale lets max commute with score scaling. Maxima use base-2 units.
        addi  r25, r9, 0
        fmul  r12, r12, r25
        fmax  r12, r12, r10
        fsub  r13, r10, r12
        ex2   r13, r13             ; alpha = 2^(old_max - new_max)
        addi  r10, r12, 0
        mov   r14, 0
        umov  ur1, 0
        mov   r2, 0
        addi  r0, r7, 0           ; chunk zero of this row, unshuffled

; Pass 2: exp(score - max), FP32 row sum, packed-half P in the swizzle64
; layout the MMA reads (one 16-byte piece per chunk of eight columns).
MAKE_P:
        acc.ld.v8 r16, S, ur0
        addi  r24, r9, 0
        addi  r25, r9, 0
        fmul  r16, r16, r24
        fmul  r17, r17, r24
        fmul  r18, r18, r25
        fmul  r19, r19, r24
        fmul  r20, r20, r24
        fmul  r21, r21, r25
        fmul  r22, r22, r24
        fmul  r23, r23, r24
        addi  r24, r12, 0
        addi  r25, r12, 0
        fsub  r16, r16, r24
        fsub  r17, r17, r24
        fsub  r18, r18, r25
        fsub  r19, r19, r24
        fsub  r20, r20, r24
        fsub  r21, r21, r25
        fsub  r22, r22, r24
        fsub  r23, r23, r24
        ex2   r16, r16
        ex2   r17, r17
        ex2   r18, r18
        ex2   r19, r19
        ex2   r20, r20
        ex2   r21, r21
        ex2   r22, r22
        ex2   r23, r23
        fadd  r24, r16, r17
        fadd  r25, r18, r19
        fadd  r26, r20, r21
        fadd  r27, r22, r23
        fadd  r28, r24, r25
        fadd  r29, r26, r27
        fadd  r28, r28, r29
        fadd  r14, r14, r28
        xor   r4, r0, r8          ; the chunk's word 0 (its four words: r4 XOR 0, 4, 8, 12)
        cvt.pack.f16x2 r27, r16, r17
        sts   [r4], r27
        xori  r5, r4, 4
        cvt.pack.f16x2 r27, r18, r19
        sts   [r5], r27
        xori  r5, r4, 8
        cvt.pack.f16x2 r27, r20, r21
        sts   [r5], r27
        xori  r5, r4, 12
        cvt.pack.f16x2 r27, r22, r23
        sts   [r5], r27
        addi  r0, r0, 16
        uaddi ur1, ur1, 8
        addi  r2, r2, 8
        setp.lt p2, r2, 64
@p2     bra.uni MAKE_P

        fmul  r11, r11, r13
        addi  r15, r14, 0
        fadd  r11, r11, r15
        sts   [r3], r10           ; per-block diagnostic row max
        sts   [r3+256], r11       ; denominator before final normalization
        sts   [r3+512], r13       ; alpha (zero for first block)
        addi  r3, r3, 1024
        setp.eq p2, r6, 0
@p2     bra.uni P_READY           ; first PV uses init; never read uninitialized O

; Correct the old FP32 numerator BEFORE accumulating this block's PV.
        umov  ur1, 0
        mov   r2, 0
        addi  r24, r13, 0
        addi  r25, r13, 0
CORRECT_O:
        acc.ld.v8 r16, O, ur0
        fmul  r16, r16, r24
        fmul  r17, r17, r24
        fmul  r18, r18, r25
        fmul  r19, r19, r24
        fmul  r20, r20, r24
        fmul  r21, r21, r25
        fmul  r22, r22, r24
        fmul  r23, r23, r24
        acc.st.v8 O, ur0, r16
        uaddi ur1, ur1, 8
        addi  r2, r2, 8
        setp.lt p2, r2, 64
@p2     bra.uni CORRECT_O

P_READY:
        mbar.arrive [ur4]         ; qtxc waits for this warp's sts + acc.st depbar
PV_READY:
        mbar.try_wait p1, [ur5], ur6
@!p1    bra.uni PV_READY
        addi  r6, r6, 1
        uaddi ur6, ur6, 1
        setp.lt p2, r6, 2
@p2     bra.uni WORK_BLOCK

; Final normalization, one row per lane, staged in shmem as an fp32
; swizzle64 tile (256-byte rows) for one TMA store of the whole tile:
;   addr(row, col) = OSTAGE + 256*row + ((4*col) XOR r8)
; A chunk of eight columns is 32 unshuffled bytes at r0 (OSTAGE + 256*row +
; 32*chunk); its column j is at (r0 XOR r8) XOR 4j. A column sts over 16 rows
; takes one bank round. RF banks (reg mod 3): the addresses r30 (bank 0),
; r31 / r4 (bank 1) and r5 (bank 2) are paired with values of other banks;
; columns c+2 and c+3 are scaled into r26 (bank 2) and r27 (bank 0).
        rcp   r13, r11
        addi  r24, r13, 0
        addi  r25, r13, 0
        umov  ur1, 0
        mov   r2, 0
        shli  r0, r1, 8
        addi  r0, r0, OSTAGE      ; chunk zero of this row, unshuffled
        umov  ur7, OSTAGE_DONE
NORMALIZE:
        acc.ld.v8 r16, O, ur0
        fmul  r16, r16, r24
        fmul  r17, r17, r24
        fmul  r26, r18, r25
        fmul  r27, r19, r24
        fmul  r20, r20, r24
        fmul  r21, r21, r25
        fmul  r22, r22, r24
        fmul  r23, r23, r24
        xor   r30, r0, r8         ; col c
        sts   [r30], r16
        xori  r31, r30, 4         ; col c+1
        sts   [r31], r17
        xori  r4, r30, 8          ; col c+2
        sts   [r4], r26
        xori  r5, r30, 12         ; col c+3
        sts   [r5], r27
        xori  r31, r30, 16        ; col c+4 (the next 16-byte piece)
        sts   [r31], r20
        xori  r4, r30, 20         ; col c+5
        sts   [r4], r21
        xori  r5, r30, 24         ; col c+6
        sts   [r5], r22
        xori  r31, r30, 28        ; col c+7
        sts   [r31], r23
        addi  r0, r0, 32
        uaddi ur1, ur1, 8
        addi  r2, r2, 8
        setp.lt p2, r2, 64
@p2     bra.uni NORMALIZE

        mbar.arrive [ur7]         ; qtxc waits for this warp's sts depbar
        halt

; ---- issuer: two unrolled blocks; block 1's inputs prefetch under block 0 ----
ISSUER:
; Every stage tile is 64 swizzle64 rows of 128 bytes (64 fp16), so each
; MMA command names row spacing 128 and its operands' 16-byte piece in row
; 0: K = 8 values per command, the next command's piece 16 bytes on.
; Issuer uniform registers: ur0 / ur1 the MMA A / B addresses, ur2
; INPUT_DONE, ur3 SCORE_DONE, ur4 WORK_DONE, ur5 OUTPUT_DONE, ur6 OSTAGE_DONE,
; ur7 OSTORE_DONE; the TMA's: ur8 / ur9 the tile's coordinates (c0 the head
; channel, c1 the row: 0, or 64 for block 1's keys), ur10 .. ur14 the stage
; buffers (Q, K0, V0, K1, V1), ur15 the output staging buffer.
        umov  ur2, INPUT_DONE
        umov  ur8, 0
        umov  ur9, 0
        umov  ur10, QBUF
        umov  ur11, KBUF0
        umov  ur12, VBUF0
        umov  ur3, SCORE_DONE
        umov  ur4, WORK_DONE
        umov  ur5, OUTPUT_DONE
; Prologue: Q and block 0's K/V land together — one barrier round trip.
        mbar.arrive.expect_tx [ur2], 24576
        tma.load.2d [ur10], [QDESC, ur8], [ur2]
        tma.load.2d [ur11], [KDESC, ur8], [ur2]
        tma.load.2d [ur12], [VDESC, ur8], [ur2]
        umov  ur13, KBUF1
        umov  ur14, VBUF1
        umov  ur15, OSTAGE
IN0:
        mbar.try_wait p1, [ur2], 0
@!p1    bra.uni IN0
; Prefetch block 1 into stage set 1: port A fills while MMA reads set 0.
        umov  ur9, 64
        mbar.arrive.expect_tx [ur2], 16384
        tma.load.2d [ur13], [KDESC, ur8], [ur2]
        tma.load.2d [ur14], [VDESC, ur8], [ur2]
        umov  ur9, 0

        umov  ur0, QBUF
        umov  ur1, KBUF0
        mma.async.init.m64n64k8 S, [ur0, 128], [ur1, 128]
        uaddi ur0, ur0, 16
        uaddi ur1, ur1, 16
        mma.async.m64n64k8 S, [ur0, 128], [ur1, 128]
        uaddi ur0, ur0, 16
        uaddi ur1, ur1, 16
        mma.async.m64n64k8 S, [ur0, 128], [ur1, 128]
        uaddi ur0, ur0, 16
        uaddi ur1, ur1, 16
        mma.async.m64n64k8 S, [ur0, 128], [ur1, 128]
        uaddi ur0, ur0, 16
        uaddi ur1, ur1, 16
        mma.async.m64n64k8 S, [ur0, 128], [ur1, 128]
        uaddi ur0, ur0, 16
        uaddi ur1, ur1, 16
        mma.async.m64n64k8 S, [ur0, 128], [ur1, 128]
        uaddi ur0, ur0, 16
        uaddi ur1, ur1, 16
        mma.async.m64n64k8 S, [ur0, 128], [ur1, 128]
        uaddi ur0, ur0, 16
        uaddi ur1, ur1, 16
        mma.async.m64n64k8 S, [ur0, 128], [ur1, 128]
        mma.commit [ur3]
W0:
        mbar.try_wait p1, [ur4], 0
@!p1    bra.uni W0

        umov  ur0, PBUF
        umov  ur1, VBUF0
        mma.async.init.m64n64k8 O, [ur0, 128], [ur1, 128]
        uaddi ur0, ur0, 16
        uaddi ur1, ur1, 16
        mma.async.m64n64k8 O, [ur0, 128], [ur1, 128]
        uaddi ur0, ur0, 16
        uaddi ur1, ur1, 16
        mma.async.m64n64k8 O, [ur0, 128], [ur1, 128]
        uaddi ur0, ur0, 16
        uaddi ur1, ur1, 16
        mma.async.m64n64k8 O, [ur0, 128], [ur1, 128]
        uaddi ur0, ur0, 16
        uaddi ur1, ur1, 16
        mma.async.m64n64k8 O, [ur0, 128], [ur1, 128]
        uaddi ur0, ur0, 16
        uaddi ur1, ur1, 16
        mma.async.m64n64k8 O, [ur0, 128], [ur1, 128]
        uaddi ur0, ur0, 16
        uaddi ur1, ur1, 16
        mma.async.m64n64k8 O, [ur0, 128], [ur1, 128]
        uaddi ur0, ur0, 16
        uaddi ur1, ur1, 16
        mma.async.m64n64k8 O, [ur0, 128], [ur1, 128]
        mma.commit [ur5]
; Block 1: data long since prefetched; QK(1) queues behind PV(0)'s commit
; fence and the engine flows through with no issuer round trip.
IN1:
        mbar.try_wait p1, [ur2], 1
@!p1    bra.uni IN1
        umov  ur0, QBUF
        umov  ur1, KBUF1
        mma.async.init.m64n64k8 S, [ur0, 128], [ur1, 128]
        uaddi ur0, ur0, 16
        uaddi ur1, ur1, 16
        mma.async.m64n64k8 S, [ur0, 128], [ur1, 128]
        uaddi ur0, ur0, 16
        uaddi ur1, ur1, 16
        mma.async.m64n64k8 S, [ur0, 128], [ur1, 128]
        uaddi ur0, ur0, 16
        uaddi ur1, ur1, 16
        mma.async.m64n64k8 S, [ur0, 128], [ur1, 128]
        uaddi ur0, ur0, 16
        uaddi ur1, ur1, 16
        mma.async.m64n64k8 S, [ur0, 128], [ur1, 128]
        uaddi ur0, ur0, 16
        uaddi ur1, ur1, 16
        mma.async.m64n64k8 S, [ur0, 128], [ur1, 128]
        uaddi ur0, ur0, 16
        uaddi ur1, ur1, 16
        mma.async.m64n64k8 S, [ur0, 128], [ur1, 128]
        uaddi ur0, ur0, 16
        uaddi ur1, ur1, 16
        mma.async.m64n64k8 S, [ur0, 128], [ur1, 128]
        mma.commit [ur3]
W1:
        mbar.try_wait p1, [ur4], 1
@!p1    bra.uni W1
        umov  ur0, PBUF
        umov  ur1, VBUF1
        mma.async.m64n64k8 O, [ur0, 128], [ur1, 128]
        uaddi ur0, ur0, 16
        uaddi ur1, ur1, 16
        mma.async.m64n64k8 O, [ur0, 128], [ur1, 128]
        uaddi ur0, ur0, 16
        uaddi ur1, ur1, 16
        mma.async.m64n64k8 O, [ur0, 128], [ur1, 128]
        uaddi ur0, ur0, 16
        uaddi ur1, ur1, 16
        mma.async.m64n64k8 O, [ur0, 128], [ur1, 128]
        uaddi ur0, ur0, 16
        uaddi ur1, ur1, 16
        mma.async.m64n64k8 O, [ur0, 128], [ur1, 128]
        uaddi ur0, ur0, 16
        uaddi ur1, ur1, 16
        mma.async.m64n64k8 O, [ur0, 128], [ur1, 128]
        uaddi ur0, ur0, 16
        uaddi ur1, ur1, 16
        mma.async.m64n64k8 O, [ur0, 128], [ur1, 128]
        uaddi ur0, ur0, 16
        uaddi ur1, ur1, 16
        mma.async.m64n64k8 O, [ur0, 128], [ur1, 128]
        mma.commit [ur5]
; Epilogue: the four workers stage normalized O (16 KiB) into OSTAGE; one TMA
; store writes it to gmem. The store's mbar certifies that the shmem source
; was consumed; the kernel-end drain retires the gmem writes.
        umov  ur6, OSTAGE_DONE
STAGED:
        mbar.try_wait p1, [ur6], 0
@!p1    bra.uni STAGED
        umov  ur7, OSTORE_DONE
        mbar.arrive.expect_tx [ur7], 16384
        tma.store.2d [ODESC, ur8], [ur15], [ur7]
STORED:
        mbar.try_wait p1, [ur7], 0
@!p1    bra.uni STORED
        halt
