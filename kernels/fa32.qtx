; FlashAttention on 32-row query tiles: Q[64,64], K/V[128,64], two key blocks
; of 64 keys. The same problem, inputs, outputs and checks as fa.qtx at
; a5d0652 (one 64-row query tile); here the 64 queries are two tiles of 32
; rows, each with its own score and output accumulators (S0/O0 for query rows
; 0..31, S1/O1 for rows 32..63), so that one tile's softmax runs while the
; tensor core works on the other tile. Unmasked full tiles, fp16 Q/K/V/P,
; fp32 S/O/statistics. fa32.launch.py passes the four descriptor arguments
; and has the reference and checks; trash/fa32-2026-11-19.md the measurements.
;
; Warps:
;   0     loads: six TMA loads, in the order the matmuls need them, then the
;         two 32-row output stores
;   1     matmuls: m32n64k8 commands, a commit after each group of eight
;   2, 3  softmax for query tile 0 (rows 0..15 and 16..31)
;   4, 5  softmax for query tile 1 (rows 32..47 and 48..63)
;
; The tensor core runs one in-order queue. Its order, S = scores, O = output,
; (query tile, key block):
;   S(0,0) S(1,0) S(0,1) S(1,1) O(0,0) O(1,0) O(0,1) O(1,1)
; The loads land in the order Q0 K0 Q1 K1 V0 V1. All of it (40 KiB in, then
; 16 KiB out) crosses one bus at 4 bytes a cycle, which takes longer than the
; tensor core's 8192 steps, so the first matmul starts after 12 KiB (Q0, K0),
; the scores need no V, and V1, the last load, is needed only by the last two
; groups.
;
; Who waits for what (every buffer and accumulator handed between warps has
; a barrier):
; - S(t,b) waits for Q(t) and K(b) to land and, for b = 1, for tile t's two
;   workers to arrive on P_READY(t) for block 0: they have finished reading
;   S(t), which S(t,1) overwrites.
; - O(t,b) waits for V(b) to land and for P_READY(t) of block b: P(t,b) is
;   written and O(t) corrected.
; - Tile t's workers wait for S_READY(t) (the commit after S(t,b)), and for
;   O_DONE(t) (the commit after O(t,b)) before they correct O(t) for block 1
;   and before the final normalization. A commit arrives only when every
;   matmul command issued before it has finished, its results in tmem
;   included.
; - Each tile has one P buffer per key block, so the workers write P(t,1)
;   while O(t,0) may still be reading P(t,0).
; - The output staging area overwrites Q and K block 0 (see OSTAGE below).

; tmem, in words (src/layout.hpp): the scores of all 64 query rows at
; S_TMEM, the output numerator at O_TMEM, rows of 64 words. Each tile's half
; is one m32n64 result: S0 (query rows 0..31) at S_TMEM, S1 (rows 32..63) at
; S1_TMEM, O0 and O1 the same. A softmax warp points at its own 16 rows of
; both, so the worker code is one copy for both tiles.
.equ S_TMEM,     0               ; scores, query tile 0 (and the 64-row view)
.equ S1_TMEM,    2048            ; scores, query tile 1
.equ O_TMEM,     4096            ; output numerator, query tile 0 (and the 64-row view)
.equ O1_TMEM,    6144            ; output numerator, query tile 1

; Every input and P tile is swizzle64 with 128-byte rows (64 fp16), so every
; matmul operand is [address, 128] and the next command's operands are 16
; bytes on (the next eight channels, or the next eight keys).
.equ QBUF0,      0               ; Q rows 0..31 (4 KiB)
.equ QBUF1,      4096            ; Q rows 32..63 (4 KiB)
.equ KBUF0,      8192            ; key block b: K at KBUF0 + 16384 b (8 KiB)
.equ VBUF0,      16384           ;              V at VBUF0 + 16384 b (8 KiB, transposed)
.equ KBUF1,      24576
.equ VBUF1,      32768
.equ STAGE_STEP, 16384           ; from key block 0's buffers to block 1's
; P for key block b: query row r at PBUF0 + 12288 b + 128 r, so tile t's 32
; rows start at PBUF0 + 4096 t + 12288 b. Block 0's 64 rows are fa.qtx's P.
.equ PBUF0,      40960
.equ PBUF1,      45056
.equ P_BLOCK_STEP, 12288         ; block 1's P at 53248 (16 rows of 128 bytes divide it)
; Staged fp32 output, swizzle64 with 256-byte rows: query row r at OSTAGE +
; 256 r, so tile t's 32 rows (8 KiB) start at OSTAGE + 8192 t. Tile 0's rows
; lie over Q (bytes 0..8191), tile 1's over K block 0 (8192..16383). Tile t's
; workers write them only after waiting for the commit after O(t,1), which
; comes after every score group (the last readers of Q and K), and every
; load landed before the matmul that needed it. The shmem ownership
; sanitizer checks this argument at run time.
.equ OSTAGE,     0
.equ OSTAGE_STEP, 8192
.equ STATS,      50176           ; per row: max, denominator, alpha, per block

; What the launch gives: one TMA descriptor per tensor (Q a 32-row tile, K a
; 64-key block, V the same transposed, O 32 fp32 rows): the four .param lines,
; in that order, are the kernel's signature. Everything else below is the
; kernel's own: six warps and its barriers (its two float constants are umov immediates).
;
; All of these lines together, in the order written, are the launch block:
; copied from global memory when the kernel starts, the first declared
; arriving first (README "Launch"). So they are written in the order the
; kernel first needs them: the producer's first act is an arrive on Q_LANDED
; and a load through QDESC; the other descriptors are needed only after 4 KiB
; of Q has crossed the bus. Descriptors are 64-byte aligned, so the three
; later ones sit together at the end (no padding between them).
;
; A pair of barriers is an array, `.mbar NAME[2]`: element 1 is 8 bytes after
; element 0 (tile 1's, or block 1's, after tile 0's), written NAME[1], and the
; workers reach it as NAME + 8 t. An array is one section: it arrives, and is
; waited for, whole.
; S_READY and O_DONE count one mma.commit each; P_READY and O_STAGED the two
; workers of a query tile; each LANDED barrier one TMA load (the producer's
; arrive.expect_tx); O_STORED both output stores.
.warps  6
.param  desc QDESC
.mbar Q_LANDED[2], expect 1  ; one TMA load each, phase 0 only
.mbar S_READY[2],  expect 1  ; commit after S(t,b), phase b
.mbar P_READY[2],  expect 2  ; tile t's two workers wrote P(t,b) and corrected O(t), phase b
.mbar O_DONE[2],   expect 1  ; commit after O(t,b), phase b
.mbar O_STAGED[2], expect 2  ; tile t's two workers staged its output
.mbar K_LANDED[2], expect 1
.mbar V_LANDED[2], expect 1
.mbar O_STORED,    expect 1  ; both output stores count down one phase
.param  desc KDESC
.param  desc VDESC
.param  desc ODESC

        usread ur0, WARP_ID
        usetp.eq.u32 p0, ur0, 0
@p0     bra.uni PRODUCER
        usetp.eq.u32 p0, ur0, 1
@p0     bra.uni ISSUER

; ---- softmax workers: warp 2 + w, w = 0..3, query tile w / 2 ----
;
; Vector registers: r0 the unshuffled address of the current 16- or 32-byte
; chunk (P, then the staged output), r1 query row, r3 stats pointer, r7 the
; row's P base, r8 the row's shuffle constant, r9 log2(e)/8, r10 running max,
; r11 denominator, r12 new max, r13 alpha, later the inverse denominator,
; r14 block sum, r16..23 eight columns, r24..29 reduction scratch, r39
; -infinity. Loop scratch: r30..37 the eight running maxima (pass 1); r30 /
; r31 the scale and r33 / r34 the max, one copy per RF bank they are paired
; with (pass 2); r4 / r5 / r6 / r15 a chunk's four P addresses and r38 / r36
; / r37 / r40 its four packed words; in the normalization r6, r28, r4, r5,
; r30..33 the eight staging addresses.
; The loops keep their chains apart (eight running maxima, separate pack
; registers, constants copied before the loop, the loop count first) because
; qtxc issues in the order written and a dependent float op is 9 cycles
; behind its producer.
; Uniform registers: ur0 this warp's 16 score rows in tmem (S_TMEM + 64 x its
; first query row), ur11 the same rows of O, ur10 / ur12 their ends (+ 64);
; ur1 the tmem pointer the column loops walk, eight columns a step (their
; counter), ur2 / ur13 the two constants, ur3 S_READY(t), ur4 P_READY(t), ur5
; O_DONE(t), ur6 key block (the block loop's counter and the parity of the
; three per-block barriers), ur7 O_STAGED(t), ur8 8 t, ur9 the previous
; block's parity.
; The tile is the pointer: both tiles' warps run the same code.
;
; P and the staged output are swizzle64 tiles (src/layout.hpp): row r whole
; at base + r x spacing (128 bytes for P, 256 for the output), and inside the
; row byte b at b XOR the row's constant ((r & 3) << 4 | (r & 12)): the
; 16-byte piece's slot XOR r & 3, the word's XOR (r / 4) & 3. The rule takes
; the row number from the address (base / spacing + r); counting r from query
; row 0 agrees because both P bases and OSTAGE are multiples of 16 rows.
        uaddi ur0, ur0, -2         ; w
        ushri ur8, ur0, 1          ; t
        ushli ur8, ur8, 3          ; 8 t: tile t's barrier in each pair
        ushli ur1, ur0, 4          ; 16 w: this warp's first query row
        sread r0, LANE_ID
        ur2r  r1, ur1
        add   r1, r0, r1           ; query row
        ushli ur0, ur1, 6          ; its score rows: S_TMEM (0) + 64 x 16 w
        shli  r3, r1, 2
        addi  r3, r3, STATS
        umov  ur2, 0.180336878     ; log2(e) / sqrt(64): a constant is a umov, no memory
        umov  ur13, -inf
        ur2r  r9, ur2
        ur2r  r10, ur13            ; -infinity: the running max
        ur2r  r39, ur13            ; -infinity, kept
        mov   r11, 0               ; denominator = 0.0
        umov  ur6, 0
        uaddi ur3, ur8, S_READY
        uaddi ur4, ur8, P_READY
        uaddi ur5, ur8, O_DONE
        uaddi ur7, ur8, O_STAGED
        uaddi ur10, ur0, 64        ; the end of the score rows' columns
        uaddi ur11, ur0, O_TMEM    ; the same rows of O
        uaddi ur12, ur11, 64
; This row's block-0 P base, PBUF0 + 128 row, and its shuffle constant.
        shli  r7, r1, 7
        addi  r7, r7, PBUF0
        andi  r8, r1, 3
        shli  r8, r8, 4
        andi  r27, r1, 12
        or    r8, r8, r27

WORK_BLOCK:
S_WAIT:
        mbar.try_wait p1, [ur3], ur6
@!p1    bra.uni S_WAIT

; Pass 1: row max, eight scores at a time, into eight running maxima.
        addi  r30, r39, 0
        addi  r31, r39, 0
        addi  r32, r39, 0
        addi  r33, r39, 0
        addi  r34, r39, 0
        addi  r35, r39, 0
        addi  r36, r39, 0
        addi  r37, r39, 0
        umov  ur1, ur0
ROW_MAX:
        acc.ld.v8 r16, [ur1, 64]
        uaddi ur1, ur1, 8          ; after the load has read the column
        usetp.lt.u32 p2, ur1, ur10
        fmax  r30, r30, r16
        fmax  r31, r31, r17
        fmax  r32, r32, r18
        fmax  r33, r33, r19
        fmax  r34, r34, r20
        fmax  r35, r35, r21
        fmax  r36, r36, r22
        fmax  r37, r37, r23
@p2     bra.uni ROW_MAX
        fmax  r24, r30, r31
        fmax  r25, r32, r33
        fmax  r26, r34, r35
        fmax  r27, r36, r37
        fmax  r28, r24, r25
        fmax  r29, r26, r27
        fmax  r12, r28, r29

; A positive scale lets max commute with score scaling. Maxima are in base-2 units.
        addi  r25, r9, 0
        fmul  r12, r12, r25
        fmax  r12, r12, r10
        fsub  r13, r10, r12
        ex2   r13, r13             ; alpha = 2^(old max - new max)
        addi  r10, r12, 0
        mov   r14, 0
        umov  ur1, ur0
        addi  r0, r7, 0            ; chunk zero of this row, unshuffled
        addi  r30, r9, 0
        addi  r31, r9, 0
        addi  r33, r12, 0
        addi  r34, r12, 0

; Pass 2: 2^(score - max), the fp32 row sum (the reference's order: pairs,
; pairs of pairs, then into the block sum), and P as packed halves in the
; swizzle64 layout the tensor core reads (one 16-byte piece per chunk of
; eight columns, its four words at r4 XOR 0, 4, 8, 12).
MAKE_P:
        acc.ld.v8 r16, [ur1, 64]
        uaddi ur1, ur1, 8
        usetp.lt.u32 p2, ur1, ur10
        xor   r4, r0, r8
        xori  r5, r4, 4
        xori  r6, r4, 8
        xori  r15, r4, 12
        addi  r0, r0, 16
        fmul  r16, r16, r30
        fmul  r17, r17, r30
        fmul  r18, r18, r31
        fmul  r19, r19, r30
        fmul  r20, r20, r30
        fmul  r21, r21, r31
        fmul  r22, r22, r30
        fmul  r23, r23, r30
        fsub  r16, r16, r33
        fsub  r17, r17, r33
        fsub  r18, r18, r34
        fsub  r19, r19, r33
        fsub  r20, r20, r33
        fsub  r21, r21, r34
        fsub  r22, r22, r33
        fsub  r23, r23, r33
        ex2   r16, r16
        ex2   r17, r17
        ex2   r18, r18
        ex2   r19, r19
        ex2   r20, r20
        ex2   r21, r21
        ex2   r22, r22
        ex2   r23, r23
        fadd  r24, r16, r17
        cvt.pack.f16x2 r38, r16, r17
        fadd  r25, r18, r19
        cvt.pack.f16x2 r36, r18, r19
        fadd  r26, r20, r21
        cvt.pack.f16x2 r37, r20, r21
        fadd  r27, r22, r23
        cvt.pack.f16x2 r40, r22, r23
        sts   [r4], r38
        fadd  r28, r24, r25
        sts   [r5], r36
        fadd  r29, r26, r27
        sts   [r6], r37
        sts   [r15], r40
        fadd  r28, r28, r29
        fadd  r14, r14, r28
@p2     bra.uni MAKE_P

        fmul  r11, r11, r13
        addi  r15, r14, 0
        fadd  r11, r11, r15
        sts   [r3], r10            ; per-block diagnostic row max
        sts   [r3+256], r11        ; denominator before the final normalization
        sts   [r3+512], r13        ; alpha (zero for the first block)
        addi  r3, r3, 1024
        usetp.eq.u32 p2, ur6, 0
@p2     bra.uni P_DONE             ; block 0: the first output matmul starts O (init)

; Correct the old fp32 numerator BEFORE this block's output matmul adds to
; it, once the previous block's output matmul has finished.
        uxori ur9, ur6, 1
O_PREVIOUS_WAIT:
        mbar.try_wait p1, [ur5], ur9
@!p1    bra.uni O_PREVIOUS_WAIT
        umov  ur1, ur11
        addi  r24, r13, 0
        addi  r25, r13, 0
CORRECT_O:
        acc.ld.v8 r16, [ur1, 64]
        fmul  r16, r16, r24
        fmul  r17, r17, r24
        fmul  r18, r18, r25
        fmul  r19, r19, r24
        fmul  r20, r20, r24
        fmul  r21, r21, r25
        fmul  r22, r22, r24
        fmul  r23, r23, r24
        acc.st.v8 [ur1, 64], r16
        uaddi ur1, ur1, 8
        usetp.lt.u32 p2, ur1, ur12
@p2     bra.uni CORRECT_O

P_DONE:
        mbar.arrive [ur4]          ; qtxc waits for this warp's sts and acc.st depbar
        addi  r7, r7, P_BLOCK_STEP ; the next block's P buffer
        uaddi ur6, ur6, 1
        usetp.lt.u32 p2, ur6, 2
@p2     bra.uni WORK_BLOCK

; Final normalization, one row per lane, staged in shmem as an fp32
; swizzle64 tile (256-byte rows) for the TMA store of this tile's 32 rows:
;   addr(row, col) = OSTAGE + 256 row + ((4 col) XOR r8)
; A chunk of eight columns is 32 unshuffled bytes at r0 (OSTAGE + 256 row +
; 32 chunk); its column j is at (r0 XOR r8) XOR 4 j. A column sts over 16 rows
; takes one bank round. RF banks (register mod 3): each address is in another
; bank than its value (r16 / r6, r17 / r28, r18 / r4, r19 / r5, r20 / r30,
; r21 / r31, r22 / r32, r23 / r33).
OUTPUT_WAIT:
        mbar.try_wait p1, [ur5], 1 ; the commit after O(t,1)
@!p1    bra.uni OUTPUT_WAIT
        rcp   r13, r11
        addi  r24, r13, 0
        addi  r25, r13, 0
        umov  ur1, ur11
        shli  r0, r1, 8
        addi  r0, r0, OSTAGE       ; chunk zero of this row, unshuffled
NORMALIZE:
        acc.ld.v8 r16, [ur1, 64]
        uaddi ur1, ur1, 8
        usetp.lt.u32 p2, ur1, ur12
        xor   r6, r0, r8           ; col c
        xori  r28, r6, 4           ; col c+1
        xori  r4, r6, 8            ; col c+2
        xori  r5, r6, 12           ; col c+3
        xori  r30, r6, 16          ; col c+4 (the next 16-byte piece)
        xori  r31, r6, 20          ; col c+5
        xori  r32, r6, 24          ; col c+6
        xori  r33, r6, 28          ; col c+7
        addi  r0, r0, 32
        fmul  r16, r16, r24
        fmul  r17, r17, r24
        fmul  r18, r18, r25
        fmul  r19, r19, r24
        fmul  r20, r20, r24
        fmul  r21, r21, r25
        fmul  r22, r22, r24
        fmul  r23, r23, r24
        sts   [r6], r16
        sts   [r28], r17
        sts   [r4], r18
        sts   [r5], r19
        sts   [r30], r20
        sts   [r31], r21
        sts   [r32], r22
        sts   [r33], r23
@p2     bra.uni NORMALIZE

        mbar.arrive [ur7]          ; qtxc waits for this warp's sts depbar
        halt

; ---- warp 1: the matmul issuer ----
; Two loops over the key block b: first the scores of both blocks, then the
; outputs of both blocks.
; Uniform registers: ur0 / ur1 the A / B operand addresses, ur2 b, ur3 / ur4
; block b's K / V buffer, ur5 / ur6 its K_LANDED / V_LANDED, ur7 / ur8
; Q_LANDED, ur9 the previous block's parity, ur10 / ur11 S_READY, ur12 /
; ur13 P_READY, ur14 / ur15 O_DONE, ur16 / ur17 block b's P buffers (tile 0 /
; tile 1 in each pair).
; ur18 .. ur21 the four results' tmem pointers (S0, S1, O0, O1).
; The eight commands of a group are unrolled: a loop's branch would wait for
; each command's operand reads before issuing the next. The two tiles' groups
; are written out separately (as before the accumulator became a pointer).
ISSUER:
        umov  ur18, S_TMEM
        umov  ur19, S1_TMEM
        umov  ur20, O_TMEM
        umov  ur21, O1_TMEM
        umov  ur7, Q_LANDED
        umov  ur8, Q_LANDED[1]
        umov  ur10, S_READY
        umov  ur11, S_READY[1]
        umov  ur12, P_READY
        umov  ur13, P_READY[1]
        umov  ur14, O_DONE
        umov  ur15, O_DONE[1]
        umov  ur2, 0
        umov  ur3, KBUF0
        umov  ur5, K_LANDED
SCORE_BLOCK:
        uxori ur9, ur2, 1
; S(0,b) = Q0 K(b)^T: eight K = 8 commands across the 64 channels.
Q0_WAIT:
        mbar.try_wait p1, [ur7], 0
@!p1    bra.uni Q0_WAIT
K_WAIT:
        mbar.try_wait p1, [ur5], 0
@!p1    bra.uni K_WAIT
; S(0,b) overwrites S0: tile 0's workers must be done with block b - 1. For
; b = 0 this asks for parity 1 of a barrier still in phase 0, which passes at
; once (the "already done once" convention).
S0_FREE_WAIT:
        mbar.try_wait p1, [ur12], ur9
@!p1    bra.uni S0_FREE_WAIT
        umov  ur0, QBUF0
        umov  ur1, ur3
        mma.async.init.m32n64k8 [ur18], [ur0, 128], [ur1, 128]
        uaddi ur0, ur0, 16
        uaddi ur1, ur1, 16
        mma.async.m32n64k8 [ur18], [ur0, 128], [ur1, 128]
        uaddi ur0, ur0, 16
        uaddi ur1, ur1, 16
        mma.async.m32n64k8 [ur18], [ur0, 128], [ur1, 128]
        uaddi ur0, ur0, 16
        uaddi ur1, ur1, 16
        mma.async.m32n64k8 [ur18], [ur0, 128], [ur1, 128]
        uaddi ur0, ur0, 16
        uaddi ur1, ur1, 16
        mma.async.m32n64k8 [ur18], [ur0, 128], [ur1, 128]
        uaddi ur0, ur0, 16
        uaddi ur1, ur1, 16
        mma.async.m32n64k8 [ur18], [ur0, 128], [ur1, 128]
        uaddi ur0, ur0, 16
        uaddi ur1, ur1, 16
        mma.async.m32n64k8 [ur18], [ur0, 128], [ur1, 128]
        uaddi ur0, ur0, 16
        uaddi ur1, ur1, 16
        mma.async.m32n64k8 [ur18], [ur0, 128], [ur1, 128]
        mma.commit [ur10]
; S(1,b) = Q1 K(b)^T, while tile 0's workers run the softmax of S(0,b).
Q1_WAIT:
        mbar.try_wait p1, [ur8], 0
@!p1    bra.uni Q1_WAIT
S1_FREE_WAIT:
        mbar.try_wait p1, [ur13], ur9
@!p1    bra.uni S1_FREE_WAIT
        umov  ur0, QBUF1
        umov  ur1, ur3
        mma.async.init.m32n64k8 [ur19], [ur0, 128], [ur1, 128]
        uaddi ur0, ur0, 16
        uaddi ur1, ur1, 16
        mma.async.m32n64k8 [ur19], [ur0, 128], [ur1, 128]
        uaddi ur0, ur0, 16
        uaddi ur1, ur1, 16
        mma.async.m32n64k8 [ur19], [ur0, 128], [ur1, 128]
        uaddi ur0, ur0, 16
        uaddi ur1, ur1, 16
        mma.async.m32n64k8 [ur19], [ur0, 128], [ur1, 128]
        uaddi ur0, ur0, 16
        uaddi ur1, ur1, 16
        mma.async.m32n64k8 [ur19], [ur0, 128], [ur1, 128]
        uaddi ur0, ur0, 16
        uaddi ur1, ur1, 16
        mma.async.m32n64k8 [ur19], [ur0, 128], [ur1, 128]
        uaddi ur0, ur0, 16
        uaddi ur1, ur1, 16
        mma.async.m32n64k8 [ur19], [ur0, 128], [ur1, 128]
        uaddi ur0, ur0, 16
        uaddi ur1, ur1, 16
        mma.async.m32n64k8 [ur19], [ur0, 128], [ur1, 128]
        mma.commit [ur11]
        uaddi ur3, ur3, STAGE_STEP
        uaddi ur5, ur5, 8
        uaddi ur2, ur2, 1
        usetp.lt.u32 p2, ur2, 2
@p2     bra.uni SCORE_BLOCK

        umov  ur2, 0
        umov  ur4, VBUF0
        umov  ur6, V_LANDED
        umov  ur16, PBUF0
        umov  ur17, PBUF1
OUTPUT_BLOCK:
; O(0,b) (+)= P(0,b) V(b): eight commands across the block's 64 keys.
V_WAIT:
        mbar.try_wait p1, [ur6], 0
@!p1    bra.uni V_WAIT
P0_WAIT:
        mbar.try_wait p1, [ur12], ur2
@!p1    bra.uni P0_WAIT
        umov  ur0, ur16
        umov  ur1, ur4
; Block 0's first command starts the accumulator (init); init is an opcode,
; so the loop selects between the two first commands.
        usetp.eq.u32 p2, ur2, 0
@p2     bra.uni O0_FIRST_BLOCK
        mma.async.m32n64k8 [ur20], [ur0, 128], [ur1, 128]
        bra.uni O0_REST
O0_FIRST_BLOCK:
        mma.async.init.m32n64k8 [ur20], [ur0, 128], [ur1, 128]
O0_REST:
        uaddi ur0, ur0, 16
        uaddi ur1, ur1, 16
        mma.async.m32n64k8 [ur20], [ur0, 128], [ur1, 128]
        uaddi ur0, ur0, 16
        uaddi ur1, ur1, 16
        mma.async.m32n64k8 [ur20], [ur0, 128], [ur1, 128]
        uaddi ur0, ur0, 16
        uaddi ur1, ur1, 16
        mma.async.m32n64k8 [ur20], [ur0, 128], [ur1, 128]
        uaddi ur0, ur0, 16
        uaddi ur1, ur1, 16
        mma.async.m32n64k8 [ur20], [ur0, 128], [ur1, 128]
        uaddi ur0, ur0, 16
        uaddi ur1, ur1, 16
        mma.async.m32n64k8 [ur20], [ur0, 128], [ur1, 128]
        uaddi ur0, ur0, 16
        uaddi ur1, ur1, 16
        mma.async.m32n64k8 [ur20], [ur0, 128], [ur1, 128]
        uaddi ur0, ur0, 16
        uaddi ur1, ur1, 16
        mma.async.m32n64k8 [ur20], [ur0, 128], [ur1, 128]
        mma.commit [ur14]
; O(1,b) (+)= P(1,b) V(b).
P1_WAIT:
        mbar.try_wait p1, [ur13], ur2
@!p1    bra.uni P1_WAIT
        umov  ur0, ur17
        umov  ur1, ur4
        usetp.eq.u32 p2, ur2, 0
@p2     bra.uni O1_FIRST_BLOCK
        mma.async.m32n64k8 [ur21], [ur0, 128], [ur1, 128]
        bra.uni O1_REST
O1_FIRST_BLOCK:
        mma.async.init.m32n64k8 [ur21], [ur0, 128], [ur1, 128]
O1_REST:
        uaddi ur0, ur0, 16
        uaddi ur1, ur1, 16
        mma.async.m32n64k8 [ur21], [ur0, 128], [ur1, 128]
        uaddi ur0, ur0, 16
        uaddi ur1, ur1, 16
        mma.async.m32n64k8 [ur21], [ur0, 128], [ur1, 128]
        uaddi ur0, ur0, 16
        uaddi ur1, ur1, 16
        mma.async.m32n64k8 [ur21], [ur0, 128], [ur1, 128]
        uaddi ur0, ur0, 16
        uaddi ur1, ur1, 16
        mma.async.m32n64k8 [ur21], [ur0, 128], [ur1, 128]
        uaddi ur0, ur0, 16
        uaddi ur1, ur1, 16
        mma.async.m32n64k8 [ur21], [ur0, 128], [ur1, 128]
        uaddi ur0, ur0, 16
        uaddi ur1, ur1, 16
        mma.async.m32n64k8 [ur21], [ur0, 128], [ur1, 128]
        uaddi ur0, ur0, 16
        uaddi ur1, ur1, 16
        mma.async.m32n64k8 [ur21], [ur0, 128], [ur1, 128]
        mma.commit [ur15]
        uaddi ur4, ur4, STAGE_STEP
        uaddi ur6, ur6, 8
        uaddi ur16, ur16, P_BLOCK_STEP
        uaddi ur17, ur17, P_BLOCK_STEP
        uaddi ur2, ur2, 1
        usetp.lt.u32 p2, ur2, 2
@p2     bra.uni OUTPUT_BLOCK
        halt

; ---- warp 0: loads, then the output stores ----
; Coordinates (ur8, ur9) = (c0, c1): c0 is always 0 (every tile is whole
; 64-channel rows), c1 the tile's first row: 0 or 32 for Q and the output,
; 0 or 64 for a key block. ur0 the buffer, ur1 its barrier.
PRODUCER:
        umov  ur8, 0
        umov  ur9, 0
        umov  ur0, QBUF0
        umov  ur1, Q_LANDED
        mbar.arrive.expect_tx [ur1], 4096
        tma.load.2d [ur0], [QDESC, ur8], [ur1]
        umov  ur0, KBUF0
        umov  ur1, K_LANDED
        mbar.arrive.expect_tx [ur1], 8192
        tma.load.2d [ur0], [KDESC, ur8], [ur1]
        umov  ur9, 32
        umov  ur0, QBUF1
        umov  ur1, Q_LANDED[1]
        mbar.arrive.expect_tx [ur1], 4096
        tma.load.2d [ur0], [QDESC, ur8], [ur1]
        umov  ur9, 64
        umov  ur0, KBUF1
        umov  ur1, K_LANDED[1]
        mbar.arrive.expect_tx [ur1], 8192
        tma.load.2d [ur0], [KDESC, ur8], [ur1]
; The TMA queue holds four commands; these two wait for Q0 and K0 to finish.
        umov  ur9, 0
        umov  ur0, VBUF0
        umov  ur1, V_LANDED
        mbar.arrive.expect_tx [ur1], 8192
        tma.load.2d [ur0], [VDESC, ur8], [ur1]
        umov  ur9, 64
        umov  ur0, VBUF1
        umov  ur1, V_LANDED[1]
        mbar.arrive.expect_tx [ur1], 8192
        tma.load.2d [ur0], [VDESC, ur8], [ur1]

; One store per query tile, as soon as its two workers have staged it.
; The store's barrier certifies that the shmem source was read; the
; kernel-end drain retires the gmem writes. ur2 O_STAGED(t), ur3 t.
        umov  ur9, 0
        umov  ur0, OSTAGE
        umov  ur1, O_STORED
        umov  ur2, O_STAGED
        umov  ur3, 0
        mbar.arrive.expect_tx [ur1], 16384
STORE_TILE:
STAGED_WAIT:
        mbar.try_wait p1, [ur2], 0
@!p1    bra.uni STAGED_WAIT
        tma.store.2d [ODESC, ur8], [ur0], [ur1]
        uaddi ur9, ur9, 32
        uaddi ur0, ur0, OSTAGE_STEP
        uaddi ur2, ur2, 8
        uaddi ur3, ur3, 1
        usetp.lt.u32 p2, ur3, 2
@p2     bra.uni STORE_TILE
STORED_WAIT:
        mbar.try_wait p1, [ur1], 0
@!p1    bra.uni STORED_WAIT
        halt
