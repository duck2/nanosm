; FlashAttention on 32-row query tiles: Q[64,64], K/V[128,64], two key blocks
; of 64 keys. The same problem, inputs, outputs and checks as fa.qtx at
; a5d0652 (one 64-row query tile); here the 64 queries are two tiles of 32
; rows, each with its own score and output accumulators (S0/O0 for query rows
; 0..31, S1/O1 for rows 32..63), so that one tile's softmax runs while the
; tensor core works on the other tile. Unmasked full tiles, fp16 Q/K/V/P,
; fp32 S/O/statistics. fa32.launch.py passes the four descriptor arguments
; and has the reference and checks.
;
; Warps:
;   0     loads: six TMA loads, in the order the matmuls need them, then the
;         two 32-row output stores
;   1     matmuls: m32n64k8 commands, a commit after each group of eight
;   2, 3  softmax for query tile 0 (rows 0..15 and 16..31)
;   4, 5  softmax for query tile 1 (rows 32..47 and 48..63)
;
; The tensor core runs one in-order queue. Its order, S = scores, O = output,
; (query tile, key block):
;   S(0,0) S(1,0) S(0,1) S(1,1) O(0,0) O(1,0) O(0,1) O(1,1)
; The loads land in the order Q0 K0 Q1 K1 V0 V1. All of it (40 KiB in, then
; 16 KiB out) crosses one bus at 4 bytes a cycle, which takes longer than the
; tensor core's 8192 steps, so the first matmul starts after 12 KiB (Q0, K0),
; the scores need no V, and V1, the last load, is needed only by the last two
; groups.
;
; Who waits for what (every buffer and accumulator handed between warps has
; a barrier):
; - S(t,b) waits for Q(t) and K(b) to land and, for b = 1, for tile t's two
;   workers to arrive on P_READY(t) for block 0: they have finished reading
;   S(t), which S(t,1) overwrites.
; - O(t,b) waits for V(b) to land and for P_READY(t) of block b: P(t,b) is
;   written and O(t) corrected.
; - Tile t's workers wait for S_READY(t) (the commit after S(t,b)), and for
;   O_DONE(t) (the commit after O(t,b)) before they correct O(t) for block 1
;   and before the final normalization. A commit arrives only when every
;   matmul command issued before it has finished, its results in tmem
;   included.
; - Each tile has one P buffer per key block, so the workers write P(t,1)
;   while O(t,0) may still be reading P(t,0).
; - The output staging area lies over Q and K block 0 (see OSTAGE below).

; The kernel's own memory, by name (README "Memory"): qtxc places each object,
; one after another from address 0, and the code below uses the names, their
; elements (QBUF[1]) and their properties (.row_bytes, .stride, .bytes).
;
; tmem, in words: the scores S and the output numerator O, each two tiles of
; 32 rows of 64 words (one m32n64 result per query tile). A softmax warp
; points at its own 16 rows of both, so the worker code is one copy for both
; tiles: query row r's scores are at S + r x S.row_words, tile 1's rows
; following tile 0's (an array's elements are contiguous).
.tmem  S[2],      rows=32, cols=64   ; scores, query tile t
.tmem  O[2],      rows=32, cols=64   ; output numerator, query tile t

; Every input and P tile is swizzle64 with 128-byte rows (64 fp16), so a
; matmul operand is [address, the tile's row bytes] and the next command's
; operands are 16 bytes on (the next eight channels, or the next eight keys).
.shmem QBUF[2],   rows=32, cols=64, elem=2   ; Q, query tile t
.shmem KBUF[2],   rows=64, cols=64, elem=2   ; K, key block b
.shmem VBUF[2],   rows=64, cols=64, elem=2   ; V, key block b, transposed (64 channel rows of 64 keys)
; P for key block b, query tile t is PBUF[2 b + t]: query row r of block b at
; PBUF + 2 b PBUF.stride + r PBUF.row_bytes. The workers shuffle a row's bytes
; themselves with one constant per row, counted from query row 0; that agrees
; with the layout's own row number (the address / the row bytes) only on a
; base that is a multiple of 16 rows, so these tiles ask for that alignment.
.shmem PBUF[4],   rows=32, cols=64, elem=2, align=16 * PBUF.row_bytes
; Staged fp32 output, swizzle64 with 256-byte rows: query row r at OSTAGE +
; r OSTAGE.row_bytes. It lies OVER Q (tile 0's rows) and K block 0 (tile
; 1's): tile t's workers write it only after waiting for the commit after
; O(t,1), which comes after every score group (the last readers of Q and K),
; and every load landed before the matmul that needed it. The shmem ownership
; sanitizer checks this argument at run time.
.shmem OSTAGE[2], rows=32, cols=64, elem=4, align=16 * OSTAGE.row_bytes, over=QBUF, KBUF[0]
; Per key block: three fields (row max, denominator, alpha) of 64 query rows.
.shmem STATS[2],  bytes=1024, align=4
.equ   STAT_FIELD, 64 * 4            ; one field: a fp32 per query row

; What the launch gives: one TMA descriptor per tensor (Q a 32-row tile, K a
; 64-key block, V the same transposed, O 32 fp32 rows): the four .param lines,
; in that order, are the kernel's signature. Everything else below is the
; kernel's own: six warps and its barriers (its two float constants are umov immediates).
;
; All of these lines together, in the order written, are the launch block:
; copied from global memory when the kernel starts, the first declared
; arriving first (README "Launch"). So they are written in the order the
; kernel first needs them: the producer's first act is an arrive on Q_LANDED
; and a load through QDESC; the other descriptors are needed only after 4 KiB
; of Q has crossed the bus. Descriptors are 64-byte aligned, so the three
; later ones sit together at the end (no padding between them).
;
; A pair of barriers is an array, `.mbar NAME[2]`: element 1 is 8 bytes after
; element 0 (tile 1's, or block 1's, after tile 0's), written NAME[1], and the
; workers reach it as NAME + 8 t. An array is one section: it arrives, and is
; waited for, whole.
; S_READY and O_DONE count one mma.commit each; P_READY and O_STAGED the two
; workers of a query tile; each LANDED barrier one TMA load (the producer's
; arrive.expect_tx); O_STORED both output stores.
.warps  6
.param  desc QDESC
.mbar Q_LANDED[2], expect 1  ; one TMA load each, phase 0 only
.mbar S_READY[2],  expect 1  ; commit after S(t,b), phase b
.mbar P_READY[2],  expect 2  ; tile t's two workers wrote P(t,b) and corrected O(t), phase b
.mbar O_DONE[2],   expect 1  ; commit after O(t,b), phase b
.mbar O_STAGED[2], expect 2  ; tile t's two workers staged its output
.mbar K_LANDED[2], expect 1
.mbar V_LANDED[2], expect 1
.mbar O_STORED,    expect 1  ; both output stores count down one phase
.param  desc KDESC
.param  desc VDESC
.param  desc ODESC
.reg   %col<8>
.ureg  %coord<2>

        usread %warp, WARP_ID
        usetp.eq.u32 p0, %warp, 0
@p0     bra.uni PRODUCER
        usetp.eq.u32 p0, %warp, 1
@p0     bra.uni ISSUER

; ---- softmax workers: warp 2 + w, w = 0..3, query tile w / 2 ----
;
; One softmax warp does 16 query rows, a row per lane: %row is the lane's
; query row, %col0 .. %col7 eight columns of it (a group: acc.ld.v8 fills
; eight neighbours), %max / %denom its running max and denominator.
; The loops keep their chains apart (eight running maxima, separate pack
; registers, the loop count first) because qtxc issues in the order written
; and a dependent float op is 9 cycles behind its producer. %scale_b,
; %max_b, %alpha_b and %inv_b are second copies of a value, made before a
; loop: where qtxc warned that it would copy inside the loop (two sources
; in one register-file bank), the loop reads the second copy instead.
; Uniform registers: %s_rows this warp's 16 score rows in tmem, %o_rows the
; same rows of O, %s_end / %o_end their ends; %walk the tmem pointer the
; column loops walk, eight columns a step; %block the key block (the block
; loop's counter and the parity of the three per-block barriers).
; The tile is the pointer: both tiles' warps run the same code.
;
; P and the staged output are swizzle64 tiles (src/layout.hpp): row r whole
; at base + r x spacing (128 bytes for P, 256 for the output), and inside the
; row byte b at b XOR the row's constant ((r & 3) << 4 | (r & 12)): the
; 16-byte piece's slot XOR r & 3, the word's XOR (r / 4) & 3. The rule takes
; the row number from the address (base / spacing + r); counting r from query
; row 0 agrees because PBUF and OSTAGE are declared on 16-row multiples
; (their align=).
        uaddi %w, %warp, -2        ; w
        ushri %tile8, %w, 1        ; t
        ushli %tile8, %tile8, 3    ; 8 t: tile t's barrier in each pair
        ushli %first_row, %w, 4    ; 16 w: this warp's first query row
        sread %lane, LANE_ID
        ur2r  %row, %first_row
        add   %row, %lane, %row    ; query row
        ushli %rows_at, %first_row, log2(S.row_words) ; its first row, as a word offset into S or O
        uaddi %s_rows, %rows_at, S ; its score rows
        shli  %stats, %row, 2
        addi  %stats, %stats, STATS
        umov  %scale_bits, 0.180336878 ; log2(e) / sqrt(64): a constant is a umov, no memory
        umov  %neg_inf_bits, -inf
        ur2r  %scale, %scale_bits
        ur2r  %max, %neg_inf_bits  ; -infinity: the running max
        ur2r  %neg_inf, %neg_inf_bits ; -infinity, kept
        mov   %denom, 0            ; denominator = 0.0
        umov  %block, 0
        uaddi %s_ready, %tile8, S_READY
        uaddi %p_ready, %tile8, P_READY
        uaddi %o_done, %tile8, O_DONE
        uaddi %o_staged, %tile8, O_STAGED
        uaddi %s_end, %s_rows, S.row_words ; the end of the score rows' columns
        uaddi %o_rows, %rows_at, O ; the same rows of O
        uaddi %o_end, %o_rows, O.row_words
; This row's block-0 P base, PBUF + row x PBUF.row_bytes, and its shuffle constant.
        shli  %p_row, %row, log2(PBUF.row_bytes)
        addi  %p_row, %p_row, PBUF
        andi  %shuffle, %row, 3
        shli  %shuffle, %shuffle, 4
        andi  %tmp, %row, 12
        or    %shuffle, %shuffle, %tmp

WORK_BLOCK:
S_WAIT:
        mbar.try_wait p1, [%s_ready], %block
@!p1    bra.uni S_WAIT

; Pass 1: row max, eight scores at a time, into eight running maxima.
        addi  %m0, %neg_inf, 0
        addi  %m1, %neg_inf, 0
        addi  %m2, %neg_inf, 0
        addi  %m3, %neg_inf, 0
        addi  %m4, %neg_inf, 0
        addi  %m5, %neg_inf, 0
        addi  %m6, %neg_inf, 0
        addi  %m7, %neg_inf, 0
        umov  %walk, %s_rows
ROW_MAX:
        acc.ld.v8 %col0, [%walk, S.row_words]
        uaddi %walk, %walk, 8      ; after the load has read the column
        usetp.lt.u32 p2, %walk, %s_end
        fmax  %m0, %m0, %col0
        fmax  %m1, %m1, %col1
        fmax  %m2, %m2, %col2
        fmax  %m3, %m3, %col3
        fmax  %m4, %m4, %col4
        fmax  %m5, %m5, %col5
        fmax  %m6, %m6, %col6
        fmax  %m7, %m7, %col7
@p2     bra.uni ROW_MAX
        fmax  %t0, %m0, %m1
        fmax  %t1, %m2, %m3
        fmax  %t2, %m4, %m5
        fmax  %t3, %m6, %m7
        fmax  %t4, %t0, %t1
        fmax  %t5, %t2, %t3
        fmax  %new_max, %t4, %t5

; A positive scale lets max commute with score scaling. Maxima are in base-2 units.
        fmul  %new_max, %new_max, %scale
        fmax  %new_max, %new_max, %max
        fsub  %alpha, %max, %new_max
        ex2   %alpha, %alpha       ; alpha = 2^(old max - new max)
        addi  %max, %new_max, 0
        mov   %block_sum, 0
        umov  %walk, %s_rows
        addi  %chunk, %p_row, 0    ; chunk zero of this row, unshuffled
        addi  %scale_a, %scale, 0
        addi  %scale_b, %scale, 0
        addi  %max_a, %new_max, 0
        addi  %max_b, %new_max, 0

; Pass 2: 2^(score - max), the fp32 row sum (the reference's order: pairs,
; pairs of pairs, then into the block sum), and P as packed halves in the
; swizzle64 layout the tensor core reads (one 16-byte piece per chunk of
; eight columns, its four words at %pa0 XOR 0, 4, 8, 12).
MAKE_P:
        acc.ld.v8 %col0, [%walk, S.row_words]
        uaddi %walk, %walk, 8
        usetp.lt.u32 p2, %walk, %s_end
        xor   %pa0, %chunk, %shuffle
        xori  %pa1, %pa0, 4
        xori  %pa2, %pa0, 8
        xori  %pa3, %pa0, 12
        addi  %chunk, %chunk, 16
        fmul  %col0, %col0, %scale_a
        fmul  %col1, %col1, %scale_a
        fmul  %col2, %col2, %scale_b
        fmul  %col3, %col3, %scale_a
        fmul  %col4, %col4, %scale_a
        fmul  %col5, %col5, %scale_b
        fmul  %col6, %col6, %scale_a
        fmul  %col7, %col7, %scale_a
        fsub  %col0, %col0, %max_a
        fsub  %col1, %col1, %max_a
        fsub  %col2, %col2, %max_b
        fsub  %col3, %col3, %max_a
        fsub  %col4, %col4, %max_a
        fsub  %col5, %col5, %max_b
        fsub  %col6, %col6, %max_a
        fsub  %col7, %col7, %max_a
        ex2   %col0, %col0
        ex2   %col1, %col1
        ex2   %col2, %col2
        ex2   %col3, %col3
        ex2   %col4, %col4
        ex2   %col5, %col5
        ex2   %col6, %col6
        ex2   %col7, %col7
        fadd  %sum0, %col0, %col1
        cvt.pack.f16x2 %pk0, %col0, %col1
        fadd  %sum1, %col2, %col3
        cvt.pack.f16x2 %pk1, %col2, %col3
        fadd  %sum2, %col4, %col5
        cvt.pack.f16x2 %pk2, %col4, %col5
        fadd  %sum3, %col6, %col7
        cvt.pack.f16x2 %pk3, %col6, %col7
        sts   [%pa0], %pk0
        fadd  %sum4, %sum0, %sum1
        sts   [%pa1], %pk1
        fadd  %sum5, %sum2, %sum3
        sts   [%pa2], %pk2
        sts   [%pa3], %pk3
        fadd  %sum4, %sum4, %sum5
        fadd  %block_sum, %block_sum, %sum4
@p2     bra.uni MAKE_P

        fmul  %denom, %denom, %alpha
        fadd  %denom, %denom, %block_sum
        sts   [%stats], %max       ; per-block diagnostic row max
        sts   [%stats + STAT_FIELD], %denom ; denominator before the final normalization
        sts   [%stats + 2 * STAT_FIELD], %alpha ; alpha (zero for the first block)
        addi  %stats, %stats, STATS.stride
        usetp.eq.u32 p2, %block, 0
@p2     bra.uni P_DONE             ; block 0: the first output matmul starts O (init)

; Correct the old fp32 numerator BEFORE this block's output matmul adds to
; it, once the previous block's output matmul has finished.
        uxori %prev_parity, %block, 1
O_PREVIOUS_WAIT:
        mbar.try_wait p1, [%o_done], %prev_parity
@!p1    bra.uni O_PREVIOUS_WAIT
        umov  %walk, %o_rows
        addi  %alpha_a, %alpha, 0
        addi  %alpha_b, %alpha, 0
CORRECT_O:
        acc.ld.v8 %col0, [%walk, O.row_words]
        fmul  %col0, %col0, %alpha_a
        fmul  %col1, %col1, %alpha_a
        fmul  %col2, %col2, %alpha_b
        fmul  %col3, %col3, %alpha_a
        fmul  %col4, %col4, %alpha_a
        fmul  %col5, %col5, %alpha_b
        fmul  %col6, %col6, %alpha_a
        fmul  %col7, %col7, %alpha_a
        acc.st.v8 [%walk, O.row_words], %col0
        uaddi %walk, %walk, 8
        usetp.lt.u32 p2, %walk, %o_end
@p2     bra.uni CORRECT_O

P_DONE:
        mbar.arrive [%p_ready]     ; qtxc waits for this warp's sts and acc.st depbar
        addi  %p_row, %p_row, 2 * PBUF.stride ; the next block's P tiles
        uaddi %block, %block, 1
        usetp.lt.u32 p2, %block, 2
@p2     bra.uni WORK_BLOCK

; Final normalization, one row per lane, staged in shmem as an fp32
; swizzle64 tile (256-byte rows) for the TMA store of this tile's 32 rows:
;   addr(row, col) = OSTAGE + OSTAGE.row_bytes row + ((4 col) XOR %shuffle)
; A chunk of eight columns is 32 unshuffled bytes at %out_chunk (OSTAGE + OSTAGE.row_bytes row +
; 32 chunk); its column j is at (%out_chunk XOR %shuffle) XOR 4 j. A column sts over 16 rows
; takes one bank round.
OUTPUT_WAIT:
        mbar.try_wait p1, [%o_done], 1 ; the commit after O(t,1)
@!p1    bra.uni OUTPUT_WAIT
        rcp   %inv, %denom
        addi  %inv_a, %inv, 0
        addi  %inv_b, %inv, 0
        umov  %walk, %o_rows
        shli  %out_chunk, %row, log2(OSTAGE.row_bytes)
        addi  %out_chunk, %out_chunk, OSTAGE ; chunk zero of this row, unshuffled
NORMALIZE:
        acc.ld.v8 %col0, [%walk, O.row_words]
        uaddi %walk, %walk, 8
        usetp.lt.u32 p2, %walk, %o_end
        xor   %oa0, %out_chunk, %shuffle ; col c
        xori  %oa1, %oa0, 4        ; col c+1
        xori  %oa2, %oa0, 8        ; col c+2
        xori  %oa3, %oa0, 12       ; col c+3
        xori  %oa4, %oa0, 16       ; col c+4 (the next 16-byte piece)
        xori  %oa5, %oa0, 20       ; col c+5
        xori  %oa6, %oa0, 24       ; col c+6
        xori  %oa7, %oa0, 28       ; col c+7
        addi  %out_chunk, %out_chunk, 32
        fmul  %col0, %col0, %inv_a
        fmul  %col1, %col1, %inv_a
        fmul  %col2, %col2, %inv_b
        fmul  %col3, %col3, %inv_a
        fmul  %col4, %col4, %inv_a
        fmul  %col5, %col5, %inv_b
        fmul  %col6, %col6, %inv_a
        fmul  %col7, %col7, %inv_a
        sts   [%oa0], %col0
        sts   [%oa1], %col1
        sts   [%oa2], %col2
        sts   [%oa3], %col3
        sts   [%oa4], %col4
        sts   [%oa5], %col5
        sts   [%oa6], %col6
        sts   [%oa7], %col7
@p2     bra.uni NORMALIZE

        mbar.arrive [%o_staged]    ; qtxc waits for this warp's sts depbar
        halt

; ---- warp 1: the matmul issuer ----
; Two loops over the key block b: first the scores of both blocks, then the
; outputs of both blocks.
; %a_op / %b_op walk the A / B operand addresses of a group's eight
; commands; %block is b; %acc_s0, %acc_s1, %acc_o0, %acc_o1 are the four
; results' tmem pointers.
; The eight commands of a group are unrolled: a loop's branch would wait for
; each command's operand reads before issuing the next. The two tiles' groups
; are written out separately (as before the accumulator became a pointer).
ISSUER:
        umov  %acc_s0, S[0]
        umov  %acc_s1, S[1]
        umov  %acc_o0, O[0]
        umov  %acc_o1, O[1]
        umov  %q0_landed, Q_LANDED
        umov  %q1_landed, Q_LANDED[1]
        umov  %s0_ready, S_READY
        umov  %s1_ready, S_READY[1]
        umov  %p0_ready, P_READY
        umov  %p1_ready, P_READY[1]
        umov  %o0_done, O_DONE
        umov  %o1_done, O_DONE[1]
        umov  %block, 0
        umov  %kbuf, KBUF[0]
        umov  %k_landed, K_LANDED
SCORE_BLOCK:
        uxori %prev_parity, %block, 1
; S(0,b) = Q0 K(b)^T: eight K = 8 commands across the 64 channels.
Q0_WAIT:
        mbar.try_wait p1, [%q0_landed], 0
@!p1    bra.uni Q0_WAIT
K_WAIT:
        mbar.try_wait p1, [%k_landed], 0
@!p1    bra.uni K_WAIT
; S(0,b) overwrites S0: tile 0's workers must be done with block b - 1. For
; b = 0 this asks for parity 1 of a barrier still in phase 0, which passes at
; once (the "already done once" convention).
S0_FREE_WAIT:
        mbar.try_wait p1, [%p0_ready], %prev_parity
@!p1    bra.uni S0_FREE_WAIT
        umov  %a_op, QBUF[0]
        umov  %b_op, %kbuf
        mma.async.init.m32n64k8 [%acc_s0], [%a_op, QBUF.row_bytes], [%b_op, KBUF.row_bytes]
        uaddi %a_op, %a_op, 16
        uaddi %b_op, %b_op, 16
        mma.async.m32n64k8 [%acc_s0], [%a_op, QBUF.row_bytes], [%b_op, KBUF.row_bytes]
        uaddi %a_op, %a_op, 16
        uaddi %b_op, %b_op, 16
        mma.async.m32n64k8 [%acc_s0], [%a_op, QBUF.row_bytes], [%b_op, KBUF.row_bytes]
        uaddi %a_op, %a_op, 16
        uaddi %b_op, %b_op, 16
        mma.async.m32n64k8 [%acc_s0], [%a_op, QBUF.row_bytes], [%b_op, KBUF.row_bytes]
        uaddi %a_op, %a_op, 16
        uaddi %b_op, %b_op, 16
        mma.async.m32n64k8 [%acc_s0], [%a_op, QBUF.row_bytes], [%b_op, KBUF.row_bytes]
        uaddi %a_op, %a_op, 16
        uaddi %b_op, %b_op, 16
        mma.async.m32n64k8 [%acc_s0], [%a_op, QBUF.row_bytes], [%b_op, KBUF.row_bytes]
        uaddi %a_op, %a_op, 16
        uaddi %b_op, %b_op, 16
        mma.async.m32n64k8 [%acc_s0], [%a_op, QBUF.row_bytes], [%b_op, KBUF.row_bytes]
        uaddi %a_op, %a_op, 16
        uaddi %b_op, %b_op, 16
        mma.async.m32n64k8 [%acc_s0], [%a_op, QBUF.row_bytes], [%b_op, KBUF.row_bytes]
        mma.commit [%s0_ready]
; S(1,b) = Q1 K(b)^T, while tile 0's workers run the softmax of S(0,b).
Q1_WAIT:
        mbar.try_wait p1, [%q1_landed], 0
@!p1    bra.uni Q1_WAIT
S1_FREE_WAIT:
        mbar.try_wait p1, [%p1_ready], %prev_parity
@!p1    bra.uni S1_FREE_WAIT
        umov  %a_op, QBUF[1]
        umov  %b_op, %kbuf
        mma.async.init.m32n64k8 [%acc_s1], [%a_op, QBUF.row_bytes], [%b_op, KBUF.row_bytes]
        uaddi %a_op, %a_op, 16
        uaddi %b_op, %b_op, 16
        mma.async.m32n64k8 [%acc_s1], [%a_op, QBUF.row_bytes], [%b_op, KBUF.row_bytes]
        uaddi %a_op, %a_op, 16
        uaddi %b_op, %b_op, 16
        mma.async.m32n64k8 [%acc_s1], [%a_op, QBUF.row_bytes], [%b_op, KBUF.row_bytes]
        uaddi %a_op, %a_op, 16
        uaddi %b_op, %b_op, 16
        mma.async.m32n64k8 [%acc_s1], [%a_op, QBUF.row_bytes], [%b_op, KBUF.row_bytes]
        uaddi %a_op, %a_op, 16
        uaddi %b_op, %b_op, 16
        mma.async.m32n64k8 [%acc_s1], [%a_op, QBUF.row_bytes], [%b_op, KBUF.row_bytes]
        uaddi %a_op, %a_op, 16
        uaddi %b_op, %b_op, 16
        mma.async.m32n64k8 [%acc_s1], [%a_op, QBUF.row_bytes], [%b_op, KBUF.row_bytes]
        uaddi %a_op, %a_op, 16
        uaddi %b_op, %b_op, 16
        mma.async.m32n64k8 [%acc_s1], [%a_op, QBUF.row_bytes], [%b_op, KBUF.row_bytes]
        uaddi %a_op, %a_op, 16
        uaddi %b_op, %b_op, 16
        mma.async.m32n64k8 [%acc_s1], [%a_op, QBUF.row_bytes], [%b_op, KBUF.row_bytes]
        mma.commit [%s1_ready]
        uaddi %kbuf, %kbuf, KBUF.stride
        uaddi %k_landed, %k_landed, 8
        uaddi %block, %block, 1
        usetp.lt.u32 p2, %block, 2
@p2     bra.uni SCORE_BLOCK

        umov  %block, 0
        umov  %vbuf, VBUF[0]
        umov  %v_landed, V_LANDED
        umov  %p0_buf, PBUF[0]
        umov  %p1_buf, PBUF[1]
OUTPUT_BLOCK:
; O(0,b) (+)= P(0,b) V(b): eight commands across the block's 64 keys.
V_WAIT:
        mbar.try_wait p1, [%v_landed], 0
@!p1    bra.uni V_WAIT
P0_WAIT:
        mbar.try_wait p1, [%p0_ready], %block
@!p1    bra.uni P0_WAIT
        umov  %a_op, %p0_buf
        umov  %b_op, %vbuf
; Block 0's first command starts the accumulator (init); init is an opcode,
; so the loop selects between the two first commands.
        usetp.eq.u32 p2, %block, 0
@p2     bra.uni O0_FIRST_BLOCK
        mma.async.m32n64k8 [%acc_o0], [%a_op, PBUF.row_bytes], [%b_op, VBUF.row_bytes]
        bra.uni O0_REST
O0_FIRST_BLOCK:
        mma.async.init.m32n64k8 [%acc_o0], [%a_op, PBUF.row_bytes], [%b_op, VBUF.row_bytes]
O0_REST:
        uaddi %a_op, %a_op, 16
        uaddi %b_op, %b_op, 16
        mma.async.m32n64k8 [%acc_o0], [%a_op, PBUF.row_bytes], [%b_op, VBUF.row_bytes]
        uaddi %a_op, %a_op, 16
        uaddi %b_op, %b_op, 16
        mma.async.m32n64k8 [%acc_o0], [%a_op, PBUF.row_bytes], [%b_op, VBUF.row_bytes]
        uaddi %a_op, %a_op, 16
        uaddi %b_op, %b_op, 16
        mma.async.m32n64k8 [%acc_o0], [%a_op, PBUF.row_bytes], [%b_op, VBUF.row_bytes]
        uaddi %a_op, %a_op, 16
        uaddi %b_op, %b_op, 16
        mma.async.m32n64k8 [%acc_o0], [%a_op, PBUF.row_bytes], [%b_op, VBUF.row_bytes]
        uaddi %a_op, %a_op, 16
        uaddi %b_op, %b_op, 16
        mma.async.m32n64k8 [%acc_o0], [%a_op, PBUF.row_bytes], [%b_op, VBUF.row_bytes]
        uaddi %a_op, %a_op, 16
        uaddi %b_op, %b_op, 16
        mma.async.m32n64k8 [%acc_o0], [%a_op, PBUF.row_bytes], [%b_op, VBUF.row_bytes]
        uaddi %a_op, %a_op, 16
        uaddi %b_op, %b_op, 16
        mma.async.m32n64k8 [%acc_o0], [%a_op, PBUF.row_bytes], [%b_op, VBUF.row_bytes]
        mma.commit [%o0_done]
; O(1,b) (+)= P(1,b) V(b).
P1_WAIT:
        mbar.try_wait p1, [%p1_ready], %block
@!p1    bra.uni P1_WAIT
        umov  %a_op, %p1_buf
        umov  %b_op, %vbuf
        usetp.eq.u32 p2, %block, 0
@p2     bra.uni O1_FIRST_BLOCK
        mma.async.m32n64k8 [%acc_o1], [%a_op, PBUF.row_bytes], [%b_op, VBUF.row_bytes]
        bra.uni O1_REST
O1_FIRST_BLOCK:
        mma.async.init.m32n64k8 [%acc_o1], [%a_op, PBUF.row_bytes], [%b_op, VBUF.row_bytes]
O1_REST:
        uaddi %a_op, %a_op, 16
        uaddi %b_op, %b_op, 16
        mma.async.m32n64k8 [%acc_o1], [%a_op, PBUF.row_bytes], [%b_op, VBUF.row_bytes]
        uaddi %a_op, %a_op, 16
        uaddi %b_op, %b_op, 16
        mma.async.m32n64k8 [%acc_o1], [%a_op, PBUF.row_bytes], [%b_op, VBUF.row_bytes]
        uaddi %a_op, %a_op, 16
        uaddi %b_op, %b_op, 16
        mma.async.m32n64k8 [%acc_o1], [%a_op, PBUF.row_bytes], [%b_op, VBUF.row_bytes]
        uaddi %a_op, %a_op, 16
        uaddi %b_op, %b_op, 16
        mma.async.m32n64k8 [%acc_o1], [%a_op, PBUF.row_bytes], [%b_op, VBUF.row_bytes]
        uaddi %a_op, %a_op, 16
        uaddi %b_op, %b_op, 16
        mma.async.m32n64k8 [%acc_o1], [%a_op, PBUF.row_bytes], [%b_op, VBUF.row_bytes]
        uaddi %a_op, %a_op, 16
        uaddi %b_op, %b_op, 16
        mma.async.m32n64k8 [%acc_o1], [%a_op, PBUF.row_bytes], [%b_op, VBUF.row_bytes]
        uaddi %a_op, %a_op, 16
        uaddi %b_op, %b_op, 16
        mma.async.m32n64k8 [%acc_o1], [%a_op, PBUF.row_bytes], [%b_op, VBUF.row_bytes]
        mma.commit [%o1_done]
        uaddi %vbuf, %vbuf, VBUF.stride
        uaddi %v_landed, %v_landed, 8
        uaddi %p0_buf, %p0_buf, 2 * PBUF.stride
        uaddi %p1_buf, %p1_buf, 2 * PBUF.stride
        uaddi %block, %block, 1
        usetp.lt.u32 p2, %block, 2
@p2     bra.uni OUTPUT_BLOCK
        halt

; ---- warp 0: loads, then the output stores ----
; Coordinates (%coord0, %coord1) = (c0, c1): c0 is always 0 (every tile is whole
; 64-channel rows), c1 the tile's first row: 0 or 32 for Q and the output,
; 0 or 64 for a key block. %buffer the buffer, %barrier its barrier.
PRODUCER:
        umov  %coord0, 0
        umov  %coord1, 0
        umov  %buffer, QBUF[0]
        umov  %barrier, Q_LANDED
        mbar.arrive.expect_tx [%barrier], QBUF[0].bytes
        tma.load.2d [%buffer], [QDESC, %coord0], [%barrier]
        umov  %buffer, KBUF[0]
        umov  %barrier, K_LANDED
        mbar.arrive.expect_tx [%barrier], KBUF[0].bytes
        tma.load.2d [%buffer], [KDESC, %coord0], [%barrier]
        umov  %coord1, 32
        umov  %buffer, QBUF[1]
        umov  %barrier, Q_LANDED[1]
        mbar.arrive.expect_tx [%barrier], QBUF[1].bytes
        tma.load.2d [%buffer], [QDESC, %coord0], [%barrier]
        umov  %coord1, 64
        umov  %buffer, KBUF[1]
        umov  %barrier, K_LANDED[1]
        mbar.arrive.expect_tx [%barrier], KBUF[1].bytes
        tma.load.2d [%buffer], [KDESC, %coord0], [%barrier]
; The TMA queue holds four commands; these two wait for Q0 and K0 to finish.
        umov  %coord1, 0
        umov  %buffer, VBUF[0]
        umov  %barrier, V_LANDED
        mbar.arrive.expect_tx [%barrier], VBUF[0].bytes
        tma.load.2d [%buffer], [VDESC, %coord0], [%barrier]
        umov  %coord1, 64
        umov  %buffer, VBUF[1]
        umov  %barrier, V_LANDED[1]
        mbar.arrive.expect_tx [%barrier], VBUF[1].bytes
        tma.load.2d [%buffer], [VDESC, %coord0], [%barrier]

; One store per query tile, as soon as its two workers have staged it.
; The store's barrier certifies that the shmem source was read; the
; kernel-end drain retires the gmem writes. %staged O_STAGED(t), %tile t.
        umov  %coord1, 0
        umov  %buffer, OSTAGE
        umov  %barrier, O_STORED
        umov  %staged, O_STAGED
        umov  %tile, 0
        mbar.arrive.expect_tx [%barrier], OSTAGE.bytes
STORE_TILE:
STAGED_WAIT:
        mbar.try_wait p1, [%staged], 0
@!p1    bra.uni STAGED_WAIT
        tma.store.2d [ODESC, %coord0], [%buffer], [%barrier]
        uaddi %coord1, %coord1, 32
        uaddi %buffer, %buffer, OSTAGE.stride
        uaddi %staged, %staged, 8
        uaddi %tile, %tile, 1
        usetp.lt.u32 p2, %tile, 2
@p2     bra.uni STORE_TILE
STORED_WAIT:
        mbar.try_wait p1, [%barrier], 0
@!p1    bra.uni STORED_WAIT
        halt
