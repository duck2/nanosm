; Vector add, C = A + B over 8192 fp32 (32 KiB per vector), four warps.
; Warp w streams its own 512 B blocks w, w+4, w+8, ... (16 blocks each).
; Interleaved v8 (rfc09): register r(base+j), lane l <-> word 16*j + l of the
; block, so one ldg.v8 is eight full-width RF writes and one stg.v8 eight
; full-width RF reads; memory order equals register order, no corner turn.
; The block base is warp-uniform and 64 B aligned, as v8 requires; ldg.v8 /
; stg.v8 still take it from lane 0 of a vector register, so the warp id goes
; through the uniform side (usread) and back with ur2r.
;
; The launch gives the three vectors' global addresses (64 B aligned) and the
; warp count. Any number of warps that divides the 64 blocks works: a warp's
; step from one of its blocks to the next is 512 B x N_WARPS, read at run
; time, and it stops when its A pointer passes the end of A.
; Launch: kernels/vadd.launch.py.

.param ptr A
.param ptr B
.param ptr C
.equ BYTES, 32768             ; per vector: 8192 fp32

        usread ur0, WARP_ID
        ushli  ur0, ur0, 9            ; 512 * warp: this warp's first block
        usread ur1, N_WARPS
        ushli  ur1, ur1, 9            ; 512 * warps: to this warp's next block
        umov   ur2, A
        umov   ur3, B
        umov   ur4, C
        lds.uni r20, [ur2]            ; the pointers' low words (an ldg.v8 /
        lds.uni r23, [ur3]            ; stg.v8 address is one 32-bit register)
        lds.uni r26, [ur4]
        ur2r   r16, ur0
        ur2r   r18, ur1
        ; r20 / r23 / r26 (bank 2) walk A, B and C; the step r18 (bank 0) and
        ; the end of A r19 (bank 1) sit in the other two banks.
        addi   r19, r20, BYTES
        add    r20, r20, r16
        add    r23, r23, r16
        add    r26, r26, r16
loop:
        ldg.v8 r0, [r20]
        ldg.v8 r8, [r23]
        ; rj and r(8+j) are always in different RF banks (j vs j+2 mod 3)
        fadd   r0, r0, r8
        fadd   r1, r1, r9
        fadd   r2, r2, r10
        fadd   r3, r3, r11
        fadd   r4, r4, r12
        fadd   r5, r5, r13
        fadd   r6, r6, r14
        fadd   r7, r7, r15
        stg.v8 [r26], r0
        add    r20, r20, r18
        add    r23, r23, r18
        add    r26, r26, r18
        setp.lt.u32 p0, r20, r19
        @p0 bra.uni loop
        halt
