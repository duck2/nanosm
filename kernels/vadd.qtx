; Vector add, C = A + B over 8192 fp32 (32 KiB per vector), four warps.
; Warp w streams its own 512 B blocks w, w+4, w+8, ... (16 blocks each).
; ldg.v8 / stg.v8 are per lane: each lane gives its own 32-byte-aligned
; address and moves that sector's eight words to or from eight neighbouring
; registers at that lane (`.reg %a<8>` declares %a0 .. %a7; the instruction
; names the first). Lane l takes the block's sector l (base + 32 l), so one
; ldg.v8 is a whole 512 B block, sixteen sector requests in lane order.
; Elementwise work does not care which lane holds which element.
;
; The launch gives the three vectors' global addresses (32 B aligned) and the
; warp count. Any number of warps that divides the 64 blocks works: a warp's
; step from one of its blocks to the next is 512 B x N_WARPS, read at run
; time, and it stops when its A pointer passes the end of A.
; Launch: kernels/vadd.launch.py.

.param ptr A
.param ptr B
.param ptr C
.equ BYTES, 32768             ; per vector: 8192 fp32
.reg %a<8>, %b<8>

        usread %first, WARP_ID
        ushli  %first, %first, 9      ; 512 * warp: this warp's first block
        usread %stride, N_WARPS
        ushli  %stride, %stride, 9    ; 512 * warps: to this warp's next block
        ld.param.u32 %a_ptr, [A]      ; the pointers' low words (an ldg.v8 /
        ld.param.u32 %b_ptr, [B]      ; stg.v8 address is one 32-bit register)
        ld.param.u32 %c_ptr, [C]
        ur2r   %offset, %first
        ur2r   %step, %stride
        sread  %lane, LANE_ID
        shli   %lane, %lane, 5        ; 32 bytes per lane: this lane's sector of a block
        add    %offset, %offset, %lane ; this lane's offset in the warp's first block
        ; %a_ptr / %b_ptr / %c_ptr walk A, B and C, one address per lane;
        ; %a_end is the end of A at this lane's offset, so every lane leaves
        ; the loop together.
        addi   %a_end, %a_ptr, BYTES
        add    %a_end, %a_end, %lane
        add    %a_ptr, %a_ptr, %offset
        add    %b_ptr, %b_ptr, %offset
        add    %c_ptr, %c_ptr, %offset
loop:
        ldg.v8 %a0, [%a_ptr]
        ldg.v8 %b0, [%b_ptr]
        fadd   %a0, %a0, %b0
        fadd   %a1, %a1, %b1
        fadd   %a2, %a2, %b2
        fadd   %a3, %a3, %b3
        fadd   %a4, %a4, %b4
        fadd   %a5, %a5, %b5
        fadd   %a6, %a6, %b6
        fadd   %a7, %a7, %b7
        stg.v8 [%c_ptr], %a0
        add    %a_ptr, %a_ptr, %step
        add    %b_ptr, %b_ptr, %step
        add    %c_ptr, %c_ptr, %step
        setp.lt.u32 p0, %a_ptr, %a_end
        @p0 bra.uni loop
        halt
