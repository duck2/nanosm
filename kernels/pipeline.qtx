; pipeline.qtx -- streaming staged vector add: the tma-less tma pipeline.
; Warp 0 stages gmem tiles into double-buffered shmem through the RF (the deliberate
; no-cp.async path); warp 1 consumes, adds, and stores to gmem. Exercises everything
; built so far: role dispatch, counted loops, ldg/sts/lds/fadd/stg, full/empty mbar
; pairs, try_wait retry loops with uxori parity toggling, and depbar scheduling.
;
; 8 tiles x 16 f32 (one lane-width each) per array. C[i] = A[i] + B[i]. Barriers are launch-image objects
; (expected=1); stages start free, so the producer peels the first two fills.
; The barrier addresses, their parities and the loop counters are uniform
; registers (ur1..ur7; the loops test their counter with usetp); the
; per-lane addresses stay vector.

.equ A,      0
.equ B,      4096
.equ C,      8192
.equ SA0,    0
.equ SB0,    64
.equ SA1,    128
.equ SB1,    192
.equ FULL0,  1024
.equ FULL1,  1032
.equ EMPTY0, 1040
.equ EMPTY1, 1048

        usread ur0, WARP_ID
        usetp.eq p0, ur0, 0
@p0     bra.uni PRODUCER

; ---- consumer: warp 1 ----
        sread r0, LANE_ID
        shli  r0, r0, 2
        addi  r10, r0, SA0
        addi  r11, r0, SB0
        addi  r12, r0, SA1
        addi  r13, r0, SB1
        addi  r1, r0, C
        umov  ur1, FULL0
        umov  ur2, FULL1
        umov  ur3, EMPTY0
        umov  ur4, EMPTY1
        umov  ur5, 0            ; FULL0 parity
        umov  ur6, 0            ; FULL1 parity
        umov  ur7, 4            ; outer iterations, two tiles each
CLOOP:  usetp.le p1, ur7, 0
@p1     bra.uni CDONE
CF0:    mbar.try_wait p3, [ur1], ur5
@!p3    bra.uni CF0
        uxori ur5, ur5, 1
        lds   r8, [r10]
        lds   r9, [r11]
        fadd  r8, r8, r9
        mbar.arrive [ur3]       ; stage 0 values live in RF; hand the buffer back
        stg   [r1], r8
        addi  r1, r1, 64
CF1:    mbar.try_wait p3, [ur2], ur6
@!p3    bra.uni CF1
        uxori ur6, ur6, 1
        lds   r8, [r12]
        lds   r9, [r13]
        fadd  r8, r8, r9
        mbar.arrive [ur4]
        stg   [r1], r8
        addi  r1, r1, 64
        uaddi ur7, ur7, -1
        bra.uni CLOOP
CDONE:  halt

; ---- producer: warp 0 ----
PRODUCER:
        sread r0, LANE_ID
        shli  r0, r0, 2
        addi  r1, r0, A
        addi  r2, r0, B
        addi  r10, r0, SA0
        addi  r11, r0, SB0
        addi  r12, r0, SA1
        addi  r13, r0, SB1
        umov  ur1, FULL0
        umov  ur2, FULL1
        umov  ur3, EMPTY0
        umov  ur4, EMPTY1
        umov  ur5, 0            ; EMPTY0 parity
        umov  ur6, 0            ; EMPTY1 parity
        ; cold start is peeled: both stages begin free, no empty wait
        ldg   r8, [r1]
        ldg   r9, [r2]
        sts   [r10], r8
        sts   [r11], r9
        mbar.arrive [ur1]       ; sts -> arrive order is free: both serialize through port A
        addi  r1, r1, 64
        addi  r2, r2, 64
        ldg   r8, [r1]
        ldg   r9, [r2]
        sts   [r12], r8
        sts   [r13], r9
        mbar.arrive [ur2]
        addi  r1, r1, 64
        addi  r2, r2, 64
        umov  ur7, 6            ; tiles left after the peel
PLOOP:  usetp.le p1, ur7, 0
@p1     bra.uni PDONE
PE0:    mbar.try_wait p3, [ur3], ur5
@!p3    bra.uni PE0
        uxori ur5, ur5, 1
        ldg   r8, [r1]
        ldg   r9, [r2]
        sts   [r10], r8
        sts   [r11], r9
        mbar.arrive [ur1]
        addi  r1, r1, 64
        addi  r2, r2, 64
        uaddi ur7, ur7, -1
        usetp.le p1, ur7, 0
@p1     bra.uni PDONE
PE1:    mbar.try_wait p3, [ur4], ur6
@!p3    bra.uni PE1
        uxori ur6, ur6, 1
        ldg   r8, [r1]
        ldg   r9, [r2]
        sts   [r12], r8
        sts   [r13], r9
        mbar.arrive [ur2]
        addi  r1, r1, 64
        addi  r2, r2, 64
        uaddi ur7, ur7, -1
        bra.uni PLOOP
PDONE:  halt
